<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NYC Taxi × Météo : DataLake Bronze · Silver · Gold</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#13222a; --bg2:#0f1b22; --panel:#1b313b; --panel2:#203844;
    --line:rgba(255,255,255,.08); --line2:rgba(255,255,255,.16);
    --text:#eef4f4; --muted:#9fb8bc; --dim:#6d8a90;
    --slate:#264653; --teal:#2a9d8f; --sand:#e9c46a; --orange:#f4a261; --red:#e76f51;
    --accent:var(--teal); --accent2:var(--sand);
    --bronze:var(--orange); --silver:#c0c5ce; --gold:var(--sand);
    --r:16px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;line-height:1.55}
  ::selection{background:var(--teal);color:#04121a}
  .mono{font-family:"JetBrains Mono",ui-monospace,Consolas,monospace}
  a{color:inherit}
  h1,h2,h3,.brand,.num{font-family:"Space Grotesk","Segoe UI",sans-serif}

  nav{position:sticky;top:0;z-index:60;display:flex;gap:6px;align-items:center;padding:12px 26px;
      background:rgba(19,34,42,.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
  nav .brand{font-weight:700;letter-spacing:.3px;margin-right:auto;display:flex;align-items:center;gap:10px}
  nav .dot{width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent)}
  nav a{color:var(--muted);text-decoration:none;font-size:.88rem;padding:6px 11px;border-radius:999px;border:1px solid transparent}
  nav a:hover{color:var(--text);border-color:var(--line2)}

  .filterbar{position:sticky;top:53px;z-index:55;background:rgba(15,27,34,.92);backdrop-filter:blur(12px);
             border-bottom:1px solid var(--line);padding:12px 26px;display:flex;gap:20px;row-gap:10px;
             align-items:center;flex-wrap:wrap}
  .filterbar .fl{color:var(--dim);font-size:.74rem;text-transform:uppercase;letter-spacing:1.5px;font-weight:600}
  .filterbar .spacer{flex:1}
  .reset{background:transparent;border:1px solid var(--line2);color:var(--muted);border-radius:999px;
         padding:6px 14px;font-size:.82rem;cursor:pointer}
  .reset:hover{border-color:var(--red);color:var(--red)}

  header{max-width:1280px;margin:0 auto;padding:84px 28px 44px}
  .kicker{font-family:"JetBrains Mono",monospace;color:var(--accent);text-transform:uppercase;
          letter-spacing:3px;font-size:.74rem;font-weight:600}
  h1{font-size:clamp(2.1rem,5vw,3.6rem);line-height:1.08;margin:14px 0 16px;letter-spacing:-.5px}
  h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1.5px var(--sand)}
  .sub{max-width:860px;color:var(--muted);font-size:1.05rem}
  .sub code{font-family:"JetBrains Mono",monospace;color:var(--sand);font-size:.95em}
  .badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
  .badge{border:1px solid var(--line);background:var(--panel2);padding:7px 13px;border-radius:999px;
         font-size:.82rem;color:var(--muted);display:inline-flex;align-items:center;gap:8px}
  .badge b{color:var(--text);font-weight:600}
  .sw{display:inline-block;width:10px;height:10px;border-radius:3px;vertical-align:-1px}

  main{max-width:1280px;margin:0 auto;padding:16px 28px 60px}
  section{margin-top:76px;scroll-margin-top:120px}
  .sec-head{display:flex;align-items:baseline;gap:16px;border-top:1px solid var(--line);padding-top:26px}
  .sec-head .idx{font-family:"JetBrains Mono",monospace;color:var(--dim);font-size:.85rem}
  h2{font-size:1.55rem;letter-spacing:-.3px}
  .lead{color:var(--muted);margin:10px 0 8px;max-width:900px}
  blockquote{border-left:3px solid var(--accent);background:var(--panel2);border-radius:0 12px 12px 0;
             padding:13px 20px;color:var(--text);font-style:italic;margin:18px 0 6px;font-size:.97rem}

  .layers{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:14px;align-items:stretch;margin-top:28px}
  .layer{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:22px;
         border-top:3px solid var(--tagc,var(--accent))}
  .layer .tag{display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;
              padding:4px 10px;border-radius:999px;background:color-mix(in srgb,var(--tagc) 14%,transparent);
              color:var(--tagc);margin-bottom:12px}
  .layer h3{margin-bottom:8px;font-size:1.06rem}
  .layer p,.layer li{color:var(--muted);font-size:.89rem}
  .layer ul{margin-top:12px;list-style:none}
  .layer li{padding-left:18px;position:relative;margin-top:6px}
  .layer li::before{content:"◆";position:absolute;left:0;color:var(--tagc);font-size:.58rem;top:6px}
  .arrow{align-self:center;color:var(--dim);font-size:1.5rem}
  @media(max-width:900px){.layers{grid-template-columns:1fr}.arrow{transform:rotate(90deg);justify-self:center}}
  .cmd{margin-top:26px;background:var(--bg2);border:1px solid var(--line);border-radius:12px;
       padding:15px 20px;color:var(--sand);font-family:"JetBrains Mono",monospace;overflow-x:auto;white-space:nowrap}
  .cmd .cmt{color:var(--dim)}

  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:12px;margin-top:26px}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 20px;position:relative;overflow:hidden}
  .kpi::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--kc,var(--accent));opacity:.85}
  .kpi .v{font-family:"JetBrains Mono",monospace;font-size:1.55rem;font-weight:600;letter-spacing:-.5px}
  .kpi .l{color:var(--muted);font-size:.82rem;margin-top:4px;text-transform:uppercase;letter-spacing:.8px}

  .duo{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
  .mapgrid{display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-top:14px}
  @media(max-width:1000px){.duo,.mapgrid{grid-template-columns:1fr}}

  .chart{width:100%;background:var(--panel);border:1px solid var(--line);border-radius:var(--r);margin-top:14px}
  .chart-pad{padding:10px}
  .chart-title{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:16px 20px 0;color:var(--muted);font-size:.9rem}
  .chart-title b{color:var(--text);font-weight:600}
  .takeaway{margin-top:14px;background:color-mix(in srgb,var(--teal) 7%,transparent);border:1px solid color-mix(in srgb,var(--teal) 25%,transparent);
            border-radius:12px;padding:13px 18px;font-size:.94rem;color:var(--text)}
  .takeaway::before{content:"Lecture : ";color:var(--teal);font-weight:700;font-size:.8rem;text-transform:uppercase;letter-spacing:1px;margin-right:6px}
  .empty{padding:34px;text-align:center;color:var(--muted)}

  .controls{display:flex;gap:18px;row-gap:12px;align-items:center;flex-wrap:wrap;margin-top:18px}
  .controls>label{color:var(--dim);font-size:.82rem;text-transform:uppercase;letter-spacing:1px}
  select{background:var(--panel);color:var(--text);border:1px solid var(--line2);border-radius:10px;
         padding:8px 12px;font-size:.92rem;outline:none;cursor:pointer}
  select:focus{border-color:var(--accent)}
  .seg{display:inline-flex;border:1px solid var(--line2);border-radius:10px;overflow:hidden}
  .seg button{background:transparent;border:none;color:var(--muted);padding:8px 15px;font-size:.88rem;cursor:pointer}
  .seg button.on{background:var(--accent);color:#04121a;font-weight:600}
  .chips{display:flex;gap:8px;flex-wrap:wrap}
  .chip{position:relative}
  .chip input{position:absolute;opacity:0;inset:0;cursor:pointer}
  .chip span{display:inline-block;padding:6px 13px;border-radius:999px;border:1px solid var(--line2);
             color:var(--muted);font-size:.86rem;transition:.15s}
  .chip input:checked + span{background:color-mix(in srgb,var(--cc,var(--teal)) 20%,transparent);
             border-color:var(--cc,var(--teal));color:var(--text)}
  .chip:hover span{border-color:var(--cc,var(--teal))}
  .hint{color:var(--dim);font-size:.8rem;margin-top:8px}

  .zcard{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:20px;margin-top:14px}
  .zcard .zn{font-family:"Space Grotesk";font-weight:700;font-size:1.15rem;color:var(--sand)}
  .zcard .zb{color:var(--dim);font-size:.82rem;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px}
  .zcard .zrow{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px dashed var(--line);font-size:.92rem}
  .zcard .zrow b{font-family:"JetBrains Mono",monospace;color:var(--text)}
  .zcard .zrow span{color:var(--muted)}
  .zcard .clear{margin-top:12px;width:100%;background:transparent;border:1px solid var(--line2);color:var(--muted);
                border-radius:10px;padding:8px;cursor:pointer;font-size:.85rem}
  .zcard .clear:hover{border-color:var(--red);color:var(--red)}

  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:24px;margin-top:14px}
  .card.warn{border-color:color-mix(in srgb,var(--sand) 30%,transparent)}
  .card .t{font-family:"Space Grotesk";font-weight:700;color:var(--sand);margin-bottom:8px}

  footer{border-top:1px solid var(--line);margin-top:90px;padding:36px 28px;text-align:center;color:var(--muted);font-size:.88rem}
  footer .stack{margin-top:10px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
</head>
<body>

<nav>
  <span class="brand"><span class="dot"></span>DataLake · NYC Taxi × Météo</span>
  <a href="#couches">Pipeline</a>
  {% for ds in payload.datasets %}{% set i = loop.index0 %}
  <a href="#apercu-{{i}}">Aperçu</a>
  <a href="#timeline-{{i}}">Chronologie</a>
  <a href="#carte-{{i}}">Carte</a>
  <a href="#analyse1-{{i}}">Suppléments</a>
  <a href="#analyse2-{{i}}">Flux</a>
  <a href="#analyse3-{{i}}">Prix/km</a>
  <a href="#analyse4-{{i}}">Activité</a>
  <a href="#analyse6-{{i}}">Distance</a>
  <a href="#analyse5-{{i}}">Météo</a>
  {% endfor %}
</nav>

<div class="filterbar" id="filterbar">
  <span class="fl">Années</span>
  <div class="chips" id="g-years"></div>
  <span class="fl">Véhicules</span>
  <div class="chips" id="g-veh"></div>
  <span class="spacer"></span>
  <button class="reset" id="g-reset">Réinitialiser les filtres</button>
</div>

<header>
  <div class="kicker">Pipeline médallion · Spark · MinIO · Viridis × 264653</div>
  <h1>Les taxis <em>New-Yorkais</em>,<br>dix-sept ans de schémas réconciliés</h1>
  <p class="sub">
    Yellow (2009), green, fhv, fhvhv (2016 → 2025)&nbsp;: les fichiers TLC changent de schéma au fil
    des ans (GPS brut avant juillet&nbsp;2016, identifiants de zone ensuite, suppléments apparus
    progressivement). Un pipeline en une seule commande&nbsp;: ingestion telle quelle dans un stockage
    objet, réconciliation distribuée avec Spark (<code>{{ payload.spark_master }}</code>), agrégats
    métier, puis ce dashboard statique. Habillage :
    <code>#264653 · #2a9d8f · #e9c46a · #f4a261 · #e76f51</code>, heatmap et carte en
    <code>viridis</code> 100 pas, du clair au foncé. Les filtres années × véhicules de la barre
    ci-dessus pilotent tous les graphiques ; cliquez une zone sur la carte pour la mettre au focus.
  </p>
  <div class="badges">
    <span class="badge"><span class="sw" style="background:var(--orange)"></span>Bronze : parquets bruts <b>tels quels</b></span>
    <span class="badge"><span class="sw" style="background:#c0c5ce"></span>Silver : schéma canonique typé</span>
    <span class="badge"><span class="sw" style="background:var(--sand)"></span>Gold : un mart JSON par analyse</span>
    <span class="badge mono">make run</span>
  </div>
</header>

<main>

<section id="couches">
  <div class="sec-head"><span class="idx">01</span><h2>Le pipeline en trois couches</h2></div>
  <p class="lead">Le brut est persisté <b>avant toute transformation</b>, puis raffiné couche par couche.
     Chaque étape tourne sur le cluster Spark (master + worker), jamais en local.</p>
  <div class="layers">
    <div class="layer" style="--tagc:var(--orange)">
      <span class="tag">Bronze</span>
      <h3>Persistance du brut</h3>
      <p>Chaque parquet est copié <b>octet pour octet</b> vers
         <span class="mono">bronze/&lt;vehicle_type&gt;/&lt;year&gt;/&lt;month&gt;/</span>.</p>
      <ul>
        <li>ingestion idempotente, manifeste auto-réparant</li>
        <li>manifeste JSON cumulé dans <span class="mono">bronze/_manifest/</span></li>
        <li>météo stub : <span class="mono">bronze/weather/&lt;year&gt;/</span></li>
      </ul>
    </div>
    <div class="arrow">➜</div>
    <div class="layer" style="--tagc:var(--silver)">
      <span class="tag">Silver</span>
      <h3>Réconciliation &amp; typage</h3>
      <p>Schémas legacy (2009), modernes, fhv et fhvhv fusionnés vers un modèle canonique unique.</p>
      <ul>
        <li>suppléments absents avant introduction → <b>null</b>, jamais 0</li>
        <li>horodatages corrompus écartés (fenêtre bornée)</li>
        <li>Parquet partitionné vehicle_type/year/month sur <span class="mono">s3a://silver/</span></li>
      </ul>
    </div>
    <div class="arrow">➜</div>
    <div class="layer" style="--tagc:var(--sand)">
      <span class="tag">Gold</span>
      <h3>Agrégats métier</h3>
      <p>Un mart JSON par analyse : suppléments, flux, prix/km, activité jour×heure,
         activité par zone, chronologie mensuelle, météo (en attente).</p>
      <ul>
        <li><span class="mono">s3a://gold/</span> puis export vers ce site</li>
        <li>agrégats légers → dashboard 100% statique et filtrable</li>
        <li>vérifiable dans la console MinIO (:9001)</li>
      </ul>
    </div>
  </div>
  <div class="cmd"><span class="cmt"># tout le pipeline, une seule commande :</span><br>make run <span class="cmt"># ajouter SAMPLE=3 pour ne traiter que 3 fichiers</span></div>
</section>

{% for ds in payload.datasets %}{% set i = loop.index0 %}
<section id="apercu-{{i}}">
  <div class="sec-head"><span class="idx">02</span><h2>Vue d'ensemble{% if ds.meta.sample_mode %} <small style="color:var(--sand)">(mode échantillon)</small>{% endif %}</h2></div>
  <p class="lead">Données ingérées depuis <span class="mono">{{ ds.meta.source_dir or "data/" }}</span>, traitées sur
     <span class="mono">{{ ds.meta.spark_master }}</span>. KPI et graphiques réagissent aux filtres globaux.</p>
  <div class="kpis">
    <div class="kpi" style="--kc:var(--teal)"><div class="v" data-kpi="total-{{i}}"></div><div class="l">courses (filtres actifs)</div></div>
    <div class="kpi" style="--kc:var(--sand)"><div class="v" data-kpi="periode-{{i}}"></div><div class="l">période filtrée</div></div>
    <div class="kpi" style="--kc:var(--orange)"><div class="v" data-kpi="annees-{{i}}"></div><div class="l">années sélectionnées</div></div>
    <div class="kpi" style="--kc:var(--red)"><div class="v" data-kpi="vehicules-{{i}}"></div><div class="l">véhicules sélectionnés</div></div>
    <div class="kpi" style="--kc:#7fb2c4"><div class="v" data-kpi="taille-{{i}}"></div><div class="l">de parquet brut ingéré</div></div>
  </div>
  <div class="duo">
    <div>
      <div class="chart-title"><b>Courses par type de véhicule</b><span>dans le filtre courant · légende cliquable</span></div>
      <div id="donut-{{i}}" class="chart chart-pad" style="height:320px"></div>
    </div>
    <div>
      <div class="chart-title"><b>Courses par année</b><span>dans le filtre courant</span></div>
      <div id="baran-{{i}}" class="chart chart-pad" style="height:320px"></div>
    </div>
  </div>
</section>

<section id="timeline-{{i}}">
  <div class="sec-head"><span class="idx">03</span><h2>Chronologie mensuelle</h2></div>
  <blockquote>«&nbsp;Comment l'activité évolue-t-elle mois par mois, par type de véhicule&nbsp;?&nbsp;»
  Empilements par véhicule, zoom au slider ou à la molette.</blockquote>
  <div id="tl-{{i}}" class="chart" style="height:420px"></div>
  <div class="takeaway" id="tk-tl-{{i}}"></div>
</section>

<section id="carte-{{i}}">
  <div class="sec-head"><span class="idx">04</span><h2>Carte des 263 zones TLC</h2></div>
  <blockquote>«&nbsp;Où les courses démarrent-elles&nbsp;? Choroplethe viridis (clair → foncé) sur les
  polygons officiels des taxi zones. Cliquez une zone pour la mettre au focus : les flux et le
  panneau de détail se mettent à jour.&nbsp;»</blockquote>
  <div class="controls">
    <label>Métrique de couleur</label>
    <div class="seg" id="map-metric-{{i}}">
      <button data-v="pickups" class="on">Départs</button>
      <button data-v="dropoffs">Arrivées</button>
      <button data-v="tarif">Tarif moyen</button>
      <button data-v="prix_km">Prix/km</button>
      <button data-v="pluie">Prix/km sous la pluie</button>
      <button data-v="ratio_pluie">Pluie / dégagé</button>
    </div>
    <label>Couches</label>
    <div class="seg" id="map-arcs-{{i}}">
      <button data-v="off" class="on">Zones seules</button>
      <button data-v="on">+ Flux top 100</button>
    </div>
  </div>
  <div class="mapgrid">
    <div id="map-{{i}}" class="chart" style="height:620px"><p class="empty" style="padding-top:270px">Chargement de la carte des 263 zones…</p></div>
    <div>
      <div class="chart-title"><b>Top zones (filtre courant)</b><span>départs</span></div>
      <div id="topz-{{i}}" class="chart chart-pad" style="height:330px"></div>
      <div class="zcard" id="zcard-{{i}}">
        <div class="zn">Aucune zone sélectionnée</div>
        <div class="zb">cliquez la carte pour focus une zone</div>
        <div class="zrow"><span>Départs</span><b>—</b></div>
        <div class="zrow"><span>Arrivées</span><b>—</b></div>
        <div class="zrow"><span>Tarif moyen</span><b>—</b></div>
        <div class="zrow"><span>Prix/km moyen</span><b>—</b></div>
      </div>
    </div>
  </div>
  <div class="takeaway" id="tk-map-{{i}}"></div>
</section>

<section id="analyse1-{{i}}">
  <div class="sec-head"><span class="idx">05</span><h2>Évolution des suppléments tarifaires</h2></div>
  <blockquote>«&nbsp;Pour chaque supplément apparu progressivement dans le schéma, montrer son évolution
     dans le temps, par type de véhicule.&nbsp;»</blockquote>
  <div class="controls">
    <label>Métrique</label>
    <div class="seg" id="met-seg-{{i}}">
      <button data-v="moyenne" class="on">Moyenne $/course</button>
      <button data-v="total">Total collecté</button>
    </div>
  </div>
  <p class="hint">Couleur = supplément · trait plein vs pointillé = véhicule · légende cliquable · filtres globaux actifs.</p>
  <div id="surcharge-{{i}}" class="chart" style="height:440px"></div>
  <div class="takeaway" id="tk-surcharge-{{i}}"></div>
</section>

<section id="analyse2-{{i}}">
  <div class="sec-head"><span class="idx">06</span><h2>Flux de prises en charge / déposes</h2></div>
  <blockquote>«&nbsp;Visualiser les flux de courses entre zones de départ et d'arrivée.&nbsp;»</blockquote>
  <div class="controls">
    <label>Visualisation</label>
    <div class="seg" id="flow-seg-{{i}}">
      <button data-v="chord" class="on">Corde</button>
      <button data-v="matrix">Matrice O→D</button>
      <button data-v="bars">Top départs</button>
    </div>
  </div>
  <div id="chord-{{i}}" class="chart" style="height:580px"></div>
  <div class="takeaway" id="tk-chord-{{i}}"></div>
</section>

<section id="analyse3-{{i}}">
  <div class="sec-head"><span class="idx">07</span><h2>Prix au km par année et zone de départ</h2></div>
  <blockquote>«&nbsp;Un ridgeline plot montrant l'évolution des prix par km au fil des années, pour une zone
     de départ donnée.&nbsp;»</blockquote>
  <div class="controls">
    <label>Ridgeline, zone</label>
    <select id="zone-sel-{{i}}"></select>
  </div>
  <div id="ridge-{{i}}" class="chart" style="height:520px"></div>
  <div class="takeaway" id="tk-ridge-{{i}}"></div>

  <div class="chart-title" style="margin-top:34px"><b>Comparateur de zones</b><span>prix/km moyen pondéré par année. Cochez plusieurs zones pour les superposer</span></div>
  <div class="controls">
    <label>Zones</label>
    <div class="chips" id="zone-chips-{{i}}"></div>
  </div>
  <div id="cmpzone-{{i}}" class="chart" style="height:400px"></div>
  <div class="takeaway" id="tk-cmpzone-{{i}}"></div>
</section>

<section id="analyse4-{{i}}">
  <div class="sec-head"><span class="idx">08</span><h2>Fréquence des courses : jour × heure</h2></div>
  <blockquote>«&nbsp;Une fonction qui, pour une année donnée en paramètre, produit une heatmap (jour de la
     semaine × heure) de la fréquence des courses, pour chaque type de véhicule.&nbsp;»</blockquote>
  <div class="controls">
    <label>Année</label>
    <select id="an-sel-{{i}}"></select>
    <label>Véhicule</label>
    <select id="vt-sel-{{i}}"></select>
  </div>
  <div id="heat-{{i}}" class="chart" style="height:450px"></div>
  <div class="takeaway" id="tk-heat-{{i}}"></div>

  <div class="chart-title" style="margin-top:34px"><b>Profil horaire</b><span>somme des 7 jours, tous les véhicules de l'année sélectionnée</span></div>
  <div id="profil-{{i}}" class="chart" style="height:330px"></div>
  <div class="takeaway" id="tk-profil-{{i}}"></div>
</section>

<section id="analyse6-{{i}}">
  <div class="sec-head"><span class="idx">09</span><h2>Distance et pourboire</h2></div>
  <blockquote>«&nbsp;Le prix au km s'effondre-t-il sur les longs trajets ? Et le pourboire
     suit-il les années ?&nbsp;»</blockquote>
  <div class="duo">
    <div>
      <div class="chart-title"><b>Prix/km par bande de distance</b><span>une courbe par année · filtres globaux actifs</span></div>
      <div id="dist-{{i}}" class="chart chart-pad" style="height:360px"></div>
    </div>
    <div>
      <div class="chart-title"><b>Taux de pourboire par année</b><span>pourboires cumulés / tarifs cumulés · légende cliquable</span></div>
      <div id="tips-{{i}}" class="chart chart-pad" style="height:360px"></div>
    </div>
  </div>
  <div class="takeaway" id="tk-dist-{{i}}"></div>
</section>

<section id="analyse5-{{i}}">
  <div class="sec-head"><span class="idx">10</span><h2>Écart de prix selon la météo</h2></div>
  <blockquote>«&nbsp;Comparer le prix des courses (par km) selon les conditions météo au moment de la course,
     par rapport au prix moyen général.&nbsp;»</blockquote>
  <div id="meteo-{{i}}"></div>
</section>
{% endfor %}

</main>

<footer>
  Pipeline : ingestion → MinIO bronze/silver/gold → PySpark sur {{ payload.spark_master }} → dashboard statique.
  <div class="stack">
    <span class="badge">Docker Compose</span><span class="badge">Spark 3.5 master + worker</span>
    <span class="badge">MinIO S3</span><span class="badge">ECharts · 263 zones TLC</span>
    <span class="badge">Généré le {{ payload.genere_le }}</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script>window.__PAYLOAD__ = {{ payload_json }};</script>
<script>
const P = window.__PAYLOAD__;
const nf = new Intl.NumberFormat('fr-FR');
const fmt = n => nf.format(Math.round(n));
const fmt2 = n => n == null ? '—' : (Math.round(n * 100) / 100).toString().replace('.', ',');
const charts = [];
const cache = {};
function mk(id){
  const el = document.getElementById(id);
  if (!cache[id]) { cache[id] = echarts.init(el); charts.push(cache[id]); }
  return cache[id];
}
window.addEventListener('resize', () => charts.forEach(c => { if (!c.isDisposed()) c.resize(); }));

/* ---------- palettes ---------- */
const SUP_COLORS = {
  'extra':'#e9c46a', 'mta_tax':'#2a9d8f', 'improvement_surcharge':'#f4a261',
  'congestion_surcharge':'#e76f51', 'airport_fee':'#8ecfc3', 'cbd_convenience_fee':'#7fb2c4'
};
const SUP_LABELS = {
  'extra':'Extra', 'mta_tax':'MTA tax', 'improvement_surcharge':'Improvement',
  'congestion_surcharge':'Congestion', 'airport_fee':'Airport fee', 'cbd_convenience_fee':'CBD fee'
};
const VIRIDIS = [
'#fde725','#f8e621','#f1e51d','#ece51b','#e5e419','#dfe318','#d8e219','#d0e11c',
'#cae11f','#c2df23','#bddf26','#b5de2b','#addc30','#a8db34','#a0da39','#9bd93c',
'#93d741','#8ed645','#86d549','#7fd34e','#7ad151','#73d056','#6ece58','#67cc5c',
'#60ca60','#5cc863','#56c667','#52c569','#4cc26c','#48c16e','#42be71','#3dbc74',
'#3aba76','#35b779','#32b67a','#2eb37c','#2ab07f','#28ae80','#25ac82','#24aa83',
'#22a785','#20a486','#1fa287','#1fa088','#1f9e89','#1e9b8a','#1f998a','#1f968b',
'#20938c','#20928c','#218f8d','#228d8d','#238a8d','#24878e','#25858e','#26828e',
'#26818e','#277e8e','#287c8e','#29798e','#2a768e','#2b748e','#2c718e','#2d708e',
'#2e6d8e','#306a8e','#31688e','#32658e','#33638d','#34608d','#365d8d','#375b8d',
'#38588c','#39558c','#3b528b','#3c508b','#3d4d8a','#3e4989','#3f4788','#414487',
'#424186','#433e85','#443a83','#453882','#463480','#46327e','#472e7c','#472c7a',
'#482878','#482475','#482173','#481d6f','#481b6d','#481769','#471365','#471063',
'#460b5e','#46085c','#450457','#440154'];
const PALETTE = ['#e9c46a','#2a9d8f','#457b8d','#f4a261','#e76f51'];
function hex2rgb(h){ return [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)]; }
function stops_color(stops, t){
  t = Math.max(0, Math.min(1, t));
  const x = t * (stops.length - 1), k = Math.min(Math.floor(x), stops.length - 2), f = x - k;
  const a = hex2rgb(stops[k]), b = hex2rgb(stops[k+1]);
  return `rgb(${Math.round(a[0]+(b[0]-a[0])*f)},${Math.round(a[1]+(b[1]-a[1])*f)},${Math.round(a[2]+(b[2]-a[2])*f)})`;
}
function vcolor(t){ return stops_color(VIRIDIS, t); }
function spread(n){ return Array.from({length:n}, (_,j) => stops_color(PALETTE, n > 1 ? j/(n-1) : 0)); }
function dashFor(idx){ return idx === 0 ? null : [8, 5]; }

/* ---------- helpers UI ---------- */
function chipBox(elId, values, onChange, opts={}){
  const box = document.getElementById(elId);
  box.innerHTML = '';
  const cols = spread(values.length || 1);
  values.forEach((v, j) => {
    const lab = document.createElement('label');
    lab.className = 'chip';
    lab.style.setProperty('--cc', opts.color === false ? undefined : cols[j]);
    const inp = document.createElement('input');
    inp.type = 'checkbox'; inp.value = v; inp.checked = true;
    inp.addEventListener('change', () => onChange());
    const sp = document.createElement('span'); sp.textContent = opts.fmt ? opts.fmt(v) : v;
    lab.append(inp, sp); box.appendChild(lab);
  });
  return () => [...box.querySelectorAll('input:checked')].map(x => x.value);
}
function segCtl(elId, onChange){
  const seg = document.getElementById(elId);
  seg.querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
    seg.querySelectorAll('button').forEach(x => x.classList.remove('on'));
    b.classList.add('on'); onChange(b.dataset.v);
  }));
  return () => seg.querySelector('button.on').dataset.v;
}
const AX = { axisLabel:{color:'#9fb8bc'}, axisLine:{lineStyle:{color:'rgba(255,255,255,.12)'}},
             splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} };
const BASE = { backgroundColor:'transparent', textStyle:{ color:'#eef4f4', fontFamily:'inherit' } };
const MOIS = ['janv.','févr.','mars','avr.','mai','juin','juil.','août','sept.','oct.','nov.','déc.'];

/* ================================================================ */
P.datasets.forEach((ds, i) => {

/* ---------- état global des filtres ---------- */
const ZONES = ds.zones || {};
const zname = id => (ZONES[id] && ZONES[id].zone) ? ZONES[id].zone : ('Zone ' + id);
const zbor = id => (ZONES[id] && ZONES[id].borough) ? ZONES[id].borough : '';
const ALL_YEARS = [...new Set(ds.timeline.rows.map(r => r.annee))].sort((a,b) => a-b);
const ALL_VEH = [...new Set(ds.timeline.rows.map(r => r.vehicle))].sort();
const STATE = { years: new Set(ALL_YEARS), veh: new Set(ALL_VEH),
                mapMetric: 'pickups', arcs: false, zone: null };

function filteredTL(){
  return ds.timeline.rows.filter(r => STATE.years.has(r.annee) && STATE.veh.has(r.vehicle));
}
function filteredZS(){
  return ds.zone_stats.rows.filter(r => STATE.years.has(r.annee) && STATE.veh.has(r.vehicle));
}

/* ---------- barre de filtres globale ---------- */
const getGY = chipBox('g-years', ALL_YEARS, applyFilters, {fmt: v => String(v)});
const getGV = chipBox('g-veh', ALL_VEH, applyFilters, {fmt: v => v});

/* Filtres partageables : #f=2009,2016|yellow,green */
function readHash(){
  const m = location.hash.match(/f=([^&]+)/);
  if (!m) return;
  const parts = decodeURIComponent(m[1]).split('|');
  if (parts[0]){
    const ys = parts[0].split(',').map(Number).filter(y => ALL_YEARS.includes(y));
    if (ys.length) STATE.years = new Set(ys);
  }
  if (parts[1]){
    const vs = parts[1].split(',').filter(v => ALL_VEH.includes(v));
    if (vs.length) STATE.veh = new Set(vs);
  }
  document.querySelectorAll('#g-years input').forEach(c => c.checked = STATE.years.has(+c.value));
  document.querySelectorAll('#g-veh input').forEach(c => c.checked = STATE.veh.has(c.value));
}
readHash();

document.getElementById('g-reset').addEventListener('click', () => {
  STATE.years = new Set(ALL_YEARS); STATE.veh = new Set(ALL_VEH);
  STATE.zone = null;
  document.querySelectorAll('#g-years input, #g-veh input').forEach(c => c.checked = true);
  applyFilters();
});

/* ---------- KPI dynamiques ---------- */
function countUp(el, target){
  const start = performance.now(), dur = 600;
  function step(t){
    const p = Math.min((t - start) / dur, 1);
    el.textContent = fmt(target * (1 - Math.pow(1 - p, 3)));
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function renderKpis(){
  const tl = filteredTL();
  const total = tl.reduce((s,r) => s + r.courses, 0);
  countUp(document.querySelector(`[data-kpi="total-${i}"]`), total);
  if (tl.length){
    const keys = tl.map(r => r.annee * 100 + r.mois).sort((a,b) => a-b);
    const lo = keys[0], hi = keys[keys.length-1];
    document.querySelector(`[data-kpi="periode-${i}"]`).textContent =
      `${String(lo%100).padStart(2,'0')}/${Math.floor(lo/100)} → ${String(hi%100).padStart(2,'0')}/${Math.floor(hi/100)}`;
  } else {
    document.querySelector(`[data-kpi="periode-${i}"]`).textContent = '—';
  }
  document.querySelector(`[data-kpi="annees-${i}"]`).textContent =
    ALL_YEARS.filter(y => STATE.years.has(y)).join(', ') || '—';
  document.querySelector(`[data-kpi="vehicules-${i}"]`).textContent =
    ALL_VEH.filter(v => STATE.veh.has(v)).join(', ') || '—';
  const go = ds.meta.taille_octets;
  document.querySelector(`[data-kpi="taille-${i}"]`).textContent =
    go ? (go / 1e9).toFixed(2).replace('.', ',') + ' Go' : 'n/a';
}

/* ---------- vue d'ensemble : donut + barres (dynamiques) ---------- */
function renderOverview(){
  const tl = filteredTL();
  const parVeh = {}, parAn = {};
  tl.forEach(r => { parVeh[r.vehicle] = (parVeh[r.vehicle]||0) + r.courses;
                    parAn[r.annee] = (parAn[r.annee]||0) + r.courses; });
  const ent = Object.entries(parVeh).sort((a,b) => b[1]-a[1]);
  const cols = spread(ent.length || 1);
  const total = ent.reduce((s,e) => s+e[1], 0);
  mk(`donut-${i}`).setOption({
    ...BASE,
    tooltip:{ formatter:p => `<b>${p.name}</b><br>${fmt(p.value)} courses (${p.percent}%)` },
    legend:{ bottom:0, textStyle:{color:'#9fb8bc'}, icon:'circle' },
    title:{ text: ent.length ? fmt(total) : '—', subtext:'courses', left:'center', top:'38%',
            textStyle:{color:'#eef4f4', fontSize:22, fontWeight:600, fontFamily:'JetBrains Mono'},
            subtextStyle:{color:'#9fb8bc'} },
    series:[{ type:'pie', radius:['52%','74%'], center:['50%','44%'],
      itemStyle:{ borderColor:'#1b313b', borderWidth:3, borderRadius:5 },
      label:{show:false},
      data: ent.map(([k,v], j) => ({ name:k, value:v, itemStyle:{color:cols[j]} })) }]
  }, true);

  const ans = Object.entries(parAn).sort((a,b) => a[0].localeCompare(b[0]));
  mk(`baran-${i}`).setOption({
    ...BASE,
    tooltip:{ trigger:'axis', axisPointer:{type:'shadow'} },
    grid:{ left:70, right:24, top:20, bottom:40 },
    xAxis:{ type:'category', data:ans.map(a=>a[0]),
            axisLabel:{color:'#9fb8bc'}, axisLine:{lineStyle:{color:'rgba(255,255,255,.12)'}} },
    yAxis:{ type:'value', axisLabel:{color:'#9fb8bc', formatter:v=>fmt(v)},
            splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} },
    series:[{ type:'bar', barMaxWidth:46,
      data:ans.map((a,j,arr) => ({ value:a[1],
        itemStyle:{ color:vcolor(arr.length>1 ? j/(arr.length-1) : .5), borderRadius:[6,6,0,0] } })),
      label:{ show:true, position:'top', color:'#9fb8bc', fontSize:10, formatter:p=>fmt(p.value) } }]
  }, true);
}

/* ---------- chronologie mensuelle ---------- */
function renderTimeline(){
  const tl = filteredTL();
  const keys = [...new Set(tl.map(r => r.annee * 100 + r.mois))].sort((a,b) => a-b);
  const labels = keys.map(k => `${String(k%100).padStart(2,'0')}/${Math.floor(k/100)}`);
  const vehs = ALL_VEH.filter(v => STATE.veh.has(v));
  const cols = spread(vehs.length || 1);
  const series = vehs.map((v, j) => ({
    name:v, type:'bar', stack:'t', barMaxWidth:26,
    itemStyle:{ color:cols[j], borderRadius: j === vehs.length-1 ? [4,4,0,0] : 0 },
    data: keys.map(k => {
      const r = tl.find(x => x.annee*100+x.mois === k && x.vehicle === v);
      return r ? r.courses : 0;
    })
  }));
  mk(`tl-${i}`).setOption({
    ...BASE,
    tooltip:{ trigger:'axis', axisPointer:{type:'shadow'},
              valueFormatter:v => fmt(v) + ' courses' },
    legend:{ top:0, textStyle:{color:'#9fb8bc'}, icon:'roundRect' },
    grid:{ left:70, right:24, top:36, bottom:70 },
    xAxis:{ type:'category', data:labels, ...AX },
    yAxis:{ type:'value', ...AX, axisLabel:{color:'#9fb8bc', formatter:v=>fmt(v)} },
    dataZoom:[{ type:'slider', height:20, bottom:12, borderColor:'rgba(255,255,255,.15)',
                backgroundColor:'rgba(255,255,255,.04)', fillerColor:'rgba(42,157,143,.25)',
                handleStyle:{color:'#2a9d8f'}, textStyle:{color:'#6d8a90'} },
              { type:'inside' }],
    series
  }, true);
  const best = tl.length ? tl.reduce((m,r) => r.courses > m.courses ? r : m) : null;
  document.getElementById(`tk-tl-${i}`).innerHTML = best
    ? `Pic d'activité du filtre courant : <b>${String(best.mois).padStart(2,'0')}/${best.annee}</b> avec ` +
      `<b>${fmt(best.courses)}</b> courses ${best.vehicle}. Zoomez avec le slider pour isoler une période.`
    : 'Aucune donnée dans le filtre courant.';
}

/* ---------- carte des zones ---------- */
const GEO_URL = 'data/geo/taxi_zones.geojson';
let CP = {};
fetch(GEO_URL).then(r => r.json()).then(gj => {
  echarts.registerMap('nyczones', {geoJSON: gj});
  gj.features.forEach(f => { CP[f.properties.locationid] = f.properties.cp; });
  /* le placeholder texte a coexiste avec l'instance creee au chargement du script :
     on nettoie le DOM ET on re-initialise l'instance sur un div propre. */
  const mapEl = document.getElementById(`map-${i}`);
  mapEl.innerHTML = '';
  if (cache[`map-${i}`]){ cache[`map-${i}`].dispose(); delete cache[`map-${i}`]; }
  renderMap(); renderTopZones();
}).catch(() => {
  document.getElementById(`map-${i}`).innerHTML =
    '<p class="empty">GeoJSON des zones introuvable (data/geo/taxi_zones.geojson).</p>';
});

function zoneAgg(){
  const rows = filteredZS();
  const by = {};
  rows.forEach(r => {
    const b = by[r.zone] = by[r.zone] ||
      {zone:r.zone, pickups:0, dropoffs:0, tarifS:0, tarifN:0, pkS:0, pkN:0};
    b.pickups += r.pickups; b.dropoffs += r.dropoffs;
    if (r.tarif_moyen != null){ b.tarifS += r.tarif_moyen * r.pickups; b.tarifN += r.pickups; }
    if (r.prix_km_moyen != null){ b.pkS += r.prix_km_moyen * r.pickups; b.pkN += r.pickups; }
  });
  return Object.values(by);
}
/* Prix/km par zone et condition météo (toutes années confondues), pour la carte. */
const WZONE = {};
if (ds.meteo.statut === 'ok'){
  ds.meteo.zone_rows.forEach(r => {
    const b = WZONE[r.zone] = WZONE[r.zone] || {};
    b[r.condition] = {v: r.prix_km_moyen, c: r.courses};
  });
}
function metricValue(b, metric){
  if (metric === 'pickups') return b.pickups;
  if (metric === 'dropoffs') return b.dropoffs;
  if (metric === 'tarif') return b.tarifN ? b.tarifS / b.tarifN : null;
  if (metric === 'pluie'){
    const w = WZONE[b.zone];
    return (w && w['Pluie'] && w['Pluie'].c >= 200) ? w['Pluie'].v : null;
  }
  if (metric === 'ratio_pluie'){
    const w = WZONE[b.zone];
    if (w && w['Pluie'] && w['Dégagé'] && w['Pluie'].c >= 200 && w['Dégagé'].c >= 200)
      return w['Pluie'].v / w['Dégagé'].v;
    return null;
  }
  return b.pkN ? b.pkS / b.pkN : null;
}
const METRIC_LABEL = {pickups:'départs', dropoffs:'arrivées', tarif:'tarif moyen $',
                      prix_km:'$/km moyen', pluie:'$/km sous la pluie',
                      ratio_pluie:'ratio pluie / dégagé'};

function renderMap(){
  const agg = zoneAgg();
  const metric = STATE.mapMetric;
  const vals = agg.map(b => metricValue(b, metric)).filter(v => v != null && v > 0);
  const data = agg.map(b => {
    const w = WZONE[b.zone] || {};
    const pluie = (w['Pluie'] && w['Pluie'].c >= 200) ? w['Pluie'].v : null;
    const clair = (w['Dégagé'] && w['Dégagé'].c >= 200) ? w['Dégagé'].v : null;
    return { name: zname(b.zone), value: metricValue(b, metric),
      locationid: b.zone, borough: zbor(b.zone),
      pickups: b.pickups, dropoffs: b.dropoffs,
      tarif: b.tarifN ? b.tarifS/b.tarifN : null, pk: b.pkN ? b.pkS/b.pkN : null,
      pluie, clair, ratio: (pluie != null && clair != null) ? pluie/clair : null,
      pluieN: w['Pluie'] ? w['Pluie'].c : 0 };
  });
  const series = [{
    type:'map', map:'nyczones', roam:true, geoIndex:0,
    selectedMode:'single',
    itemStyle:{ borderColor:'rgba(19,34,42,.9)', borderWidth:.6 },
    emphasis:{ label:{show:true, color:'#04121a', fontSize:10},
               itemStyle:{ areaColor:'#e9c46a' } },
    select:{ label:{show:true, color:'#04121a', fontSize:10},
             itemStyle:{ areaColor:'#f4a261' } },
    data
  }];
  if (STATE.arcs){
    const links = ds.flux_zones.links.filter(l => CP[l.source] && CP[l.target])
      .filter(l => STATE.zone == null || l.source === STATE.zone || l.target === STATE.zone);
    series.push({
      type:'lines', coordinateSystem:'geo', zlevel:2,
      effect:{ show:true, period:4, trailLength:.25, symbol:'arrow', symbolSize:4, color:'#e9c46a' },
      lineStyle:{ color:'#f4a261', width:1.2, opacity:.45, curveness:.3 },
      tooltip:{ show:false },
      data: links.map(l => ({ coords:[CP[l.source], CP[l.target]], value:l.count,
        from:l.source, to:l.target }))
    });
  }
  mk(`map-${i}`).setOption({
    ...BASE,
    geo:{ map:'nyczones', roam:true, silent:true,
          itemStyle:{ areaColor:'#203844', borderColor:'rgba(255,255,255,.12)' } },
    tooltip:{ formatter:p => {
      if (p.seriesType === 'lines') return '';
      const d = p.data || {};
      let extra = '';
      if (STATE.mapMetric === 'pluie' && d.pluie != null)
        extra = `<br>Prix/km sous la pluie : ${fmt2(d.pluie)} (${fmt(d.pluieN)} courses)`;
      if (STATE.mapMetric === 'ratio_pluie' && d.ratio != null)
        extra = `<br>Pluie / dégagé : ${fmt2(d.ratio)} (pluie ${fmt2(d.pluie)}, dégagé ${fmt2(d.clair)})`;
      return `<b>${p.name}</b> <span style="color:#6d8a90">· ${d.borough || '?'}</span><br>` +
        `Départs : ${fmt(d.pickups || 0)}<br>Arrivées : ${fmt(d.dropoffs || 0)}<br>` +
        `Tarif moyen : ${d.tarif != null ? '$'+fmt2(d.tarif) : '—'}<br>` +
        `Prix/km : ${d.pk != null ? fmt2(d.pk) : '—'}` + extra;
    } },
    visualMap:{ min: metric === 'ratio_pluie' ? Math.min(0.85, ...(vals.length ? vals : [1])) : 0,
      max: metric === 'ratio_pluie' ? Math.max(1.15, ...(vals.length ? vals : [1])) : Math.max(...vals, 1),
      calculable:true, orient:'vertical',
      right:8, top:'center', textStyle:{color:'#9fb8bc'},
      inRange:{ color: VIRIDIS },
      outOfRange:{ areaColor:'#24363f' } },
    series
  }, true);
  const top = [...agg].sort((a,b) => b.pickups - a.pickups)[0];
  document.getElementById(`tk-map-${i}`).innerHTML = top
    ? `Zone la plus active sur le filtre courant : <b>${zname(top.zone)}</b> ` +
      `(${zbor(top.zone)}) avec ${fmt(top.pickups)} départs. ` +
      `Cliquez une zone sur la carte pour la mettre au focus${STATE.zone != null
        ? `. Focus actuel : <b>${zname(STATE.zone)}</b>.` : '.'}`
    : 'Aucune donnée zonée dans le filtre courant (2009 = GPS brut, sans LocationID).';
}

function renderTopZones(){
  const agg = [...zoneAgg()].sort((a,b) => b.pickups - a.pickups).slice(0, 12);
  const cols = spread(agg.length || 1);
  mk(`topz-${i}`).setOption({
    ...BASE,
    tooltip:{ trigger:'axis', axisPointer:{type:'shadow'},
      formatter:p => `<b>${p[0].name}</b><br>${fmt(p[0].value)} départs` },
    grid:{ left:10, right:60, top:10, bottom:10, containLabel:true },
    xAxis:{ type:'value', show:false },
    yAxis:{ type:'category', inverse:true, data:agg.map(b => zname(b.zone)),
            axisLabel:{color:'#eef4f4', fontSize:11, width:120, overflow:'truncate'},
            axisLine:{show:false}, axisTick:{show:false} },
    series:[{ type:'bar', barMaxWidth:14,
      data:[...agg].reverse().map((b,j) => ({ value:b.pickups,
        itemStyle:{ color:cols[agg.length-1-j], borderRadius:[0,5,5,0] } })) }]
  }, true);
}

function renderZoneCard(){
  const card = document.getElementById(`zcard-${i}`);
  if (STATE.zone == null){
    card.innerHTML = `<div class="zn">Aucune zone sélectionnée</div>
      <div class="zb">cliquez la carte pour focus une zone</div>
      <div class="zrow"><span>Départs</span><b>—</b></div>
      <div class="zrow"><span>Arrivées</span><b>—</b></div>
      <div class="zrow"><span>Tarif moyen</span><b>—</b></div>
      <div class="zrow"><span>Prix/km moyen</span><b>—</b></div>`;
    return;
  }
  const b = zoneAgg().find(x => x.zone === STATE.zone);
  card.innerHTML = `<div class="zn">${zname(STATE.zone)}</div>
    <div class="zb">${zbor(STATE.zone) || '?'} · LocationID ${STATE.zone}</div>
    <div class="zrow"><span>Départs</span><b>${b ? fmt(b.pickups) : '—'}</b></div>
    <div class="zrow"><span>Arrivées</span><b>${b ? fmt(b.dropoffs) : '—'}</b></div>
    <div class="zrow"><span>Tarif moyen</span><b>${b && b.tarifN ? '$'+fmt2(b.tarifS/b.tarifN) : '—'}</b></div>
    <div class="zrow"><span>Prix/km moyen</span><b>${b && b.pkN ? '$'+fmt2(b.pkS/b.pkN) : '—'}</b></div>
    <button class="clear" id="zclear-${i}">Retirer le focus</button>`;
  document.getElementById(`zclear-${i}`).addEventListener('click', () => {
    STATE.zone = null; renderMap(); renderZoneCard();
  });
}

const getMapMetric = segCtl(`map-metric-${i}`, v => { STATE.mapMetric = v; renderMap(); renderTopZones(); });
const getMapArcs = segCtl(`map-arcs-${i}`, v => { STATE.arcs = v === 'on'; renderMap(); });
mk(`map-${i}`).on('click', params => {
  if (params.componentType === 'series' && params.seriesType === 'map' && params.data){
    STATE.zone = params.data.locationid;
    renderMap(); renderZoneCard();
