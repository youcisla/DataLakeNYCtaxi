<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NYC Taxi × Météo : DataLake Bronze · Silver · Gold</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#13222a; --bg2:#0f1b22; --panel:#1b313b; --panel2:#203844;
    --line:rgba(255,255,255,.08); --line2:rgba(255,255,255,.16);
    --text:#eef4f4; --muted:#9fb8bc; --dim:#6d8a90;
    --slate:#264653; --teal:#2a9d8f; --sand:#e9c46a; --orange:#f4a261; --red:#e76f51;
    --accent:var(--teal); --accent2:var(--sand);
    --bronze:var(--orange); --silver:#c0c5ce; --gold:var(--sand);
    --r:16px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;line-height:1.55}
  ::selection{background:var(--teal);color:#04121a}
  .mono{font-family:"JetBrains Mono",ui-monospace,Consolas,monospace}
  a{color:inherit}
  h1,h2,h3,.brand,.num{font-family:"Space Grotesk","Segoe UI",sans-serif}

  nav{position:sticky;top:0;z-index:50;display:flex;gap:6px;align-items:center;padding:12px 26px;
      background:rgba(11,13,16,.86);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
  nav .brand{font-weight:700;letter-spacing:.3px;margin-right:auto;display:flex;align-items:center;gap:10px}
  nav .dot{width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent)}
  nav a{color:var(--muted);text-decoration:none;font-size:.88rem;padding:6px 11px;border-radius:999px;border:1px solid transparent}
  nav a:hover{color:var(--text);border-color:var(--line2)}

  header{max-width:1220px;margin:0 auto;padding:84px 28px 44px}
  .kicker{font-family:"JetBrains Mono",monospace;color:var(--accent);text-transform:uppercase;
          letter-spacing:3px;font-size:.74rem;font-weight:600}
  h1{font-size:clamp(2.1rem,5vw,3.6rem);line-height:1.08;margin:14px 0 16px;letter-spacing:-.5px}
  h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1.5px var(--sand)}
  .sub{max-width:840px;color:var(--muted);font-size:1.05rem}
  .sub code{font-family:"JetBrains Mono",monospace;color:var(--teal);font-size:.95em}
  .badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
  .badge{border:1px solid var(--line);background:var(--panel2);padding:7px 13px;border-radius:999px;
         font-size:.82rem;color:var(--muted);display:inline-flex;align-items:center;gap:8px}
  .badge b{color:var(--text);font-weight:600}
  .sw{display:inline-block;width:10px;height:10px;border-radius:3px;vertical-align:-1px}

  main{max-width:1220px;margin:0 auto;padding:16px 28px 60px}
  section{margin-top:76px;scroll-margin-top:70px}
  .sec-head{display:flex;align-items:baseline;gap:16px;border-top:1px solid var(--line);padding-top:26px}
  .sec-head .idx{font-family:"JetBrains Mono",monospace;color:var(--dim);font-size:.85rem}
  h2{font-size:1.55rem;letter-spacing:-.3px}
  .lead{color:var(--muted);margin:10px 0 8px;max-width:880px}
  blockquote{border-left:3px solid var(--accent);background:var(--panel2);border-radius:0 12px 12px 0;
             padding:13px 20px;color:var(--text);font-style:italic;margin:18px 0 6px;font-size:.97rem}

  .layers{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:14px;align-items:stretch;margin-top:28px}
  .layer{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:22px;
         border-top:3px solid var(--tagc,var(--accent))}
  .layer .tag{display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;
              padding:4px 10px;border-radius:999px;background:color-mix(in srgb,var(--tagc) 14%,transparent);
              color:var(--tagc);margin-bottom:12px}
  .layer h3{margin-bottom:8px;font-size:1.06rem}
  .layer p,.layer li{color:var(--muted);font-size:.89rem}
  .layer ul{margin-top:12px;list-style:none}
  .layer li{padding-left:18px;position:relative;margin-top:6px}
  .layer li::before{content:"◆";position:absolute;left:0;color:var(--tagc);font-size:.58rem;top:6px}
  .arrow{align-self:center;color:var(--dim);font-size:1.5rem}
  @media(max-width:900px){.layers{grid-template-columns:1fr}.arrow{transform:rotate(90deg);justify-self:center}}
  .cmd{margin-top:26px;background:var(--bg2);border:1px solid var(--line);border-radius:12px;
       padding:15px 20px;color:#e9c46a;font-family:"JetBrains Mono",monospace;overflow-x:auto;white-space:nowrap}
  .cmd .cmt{color:var(--dim)}

  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:12px;margin-top:26px}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 20px;position:relative;overflow:hidden}
  .kpi::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--kc,var(--accent));opacity:.85}
  .kpi .v{font-family:"JetBrains Mono",monospace;font-size:1.55rem;font-weight:600;letter-spacing:-.5px}
  .kpi .l{color:var(--muted);font-size:.82rem;margin-top:4px;text-transform:uppercase;letter-spacing:.8px}

  .duo{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
  @media(max-width:900px){.duo{grid-template-columns:1fr}}

  .chart{width:100%;background:var(--panel);border:1px solid var(--line);border-radius:var(--r);margin-top:14px}
  .chart-pad{padding:10px}
  .chart-title{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:16px 20px 0;color:var(--muted);font-size:.9rem}
  .chart-title b{color:var(--text);font-weight:600}
  .takeaway{margin-top:14px;background:color-mix(in srgb,var(--teal) 7%,transparent);border:1px solid color-mix(in srgb,var(--teal) 25%,transparent);
            border-radius:12px;padding:13px 18px;font-size:.94rem;color:var(--text)}
  .takeaway::before{content:"Lecture : ";color:var(--teal);font-weight:700;font-size:.8rem;text-transform:uppercase;letter-spacing:1px;margin-right:6px}
  .empty{padding:34px;text-align:center;color:var(--muted)}

  .controls{display:flex;gap:18px;row-gap:12px;align-items:center;flex-wrap:wrap;margin-top:18px}
  .controls>label{color:var(--dim);font-size:.82rem;text-transform:uppercase;letter-spacing:1px}
  select{background:var(--panel);color:var(--text);border:1px solid var(--line2);border-radius:10px;
         padding:8px 12px;font-size:.92rem;outline:none;cursor:pointer}
  select:focus{border-color:var(--accent)}
  .seg{display:inline-flex;border:1px solid var(--line2);border-radius:10px;overflow:hidden}
  .seg button{background:transparent;border:none;color:var(--muted);padding:8px 15px;font-size:.88rem;cursor:pointer}
  .seg button.on{background:var(--accent);color:#04121a;font-weight:600}
  .chips{display:flex;gap:8px;flex-wrap:wrap}
  .chip{position:relative}
  .chip input{position:absolute;opacity:0;inset:0;cursor:pointer}
  .chip span{display:inline-block;padding:6px 13px;border-radius:999px;border:1px solid var(--line2);
             color:var(--muted);font-size:.86rem;transition:.15s}
  .chip input:checked + span{background:color-mix(in srgb,var(--cc,var(--teal)) 20%,transparent);
             border-color:var(--cc,var(--teal));color:var(--text)}
  .chip:hover span{border-color:var(--cc,var(--teal))}
  .hint{color:var(--dim);font-size:.8rem;margin-top:8px}

  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:24px;margin-top:14px}
  .card.warn{border-color:color-mix(in srgb,var(--sand) 30%,transparent)}
  .card .t{font-family:"Space Grotesk";font-weight:700;color:var(--sand);margin-bottom:8px}

  footer{border-top:1px solid var(--line);margin-top:90px;padding:36px 28px;text-align:center;color:var(--muted);font-size:.88rem}
  footer .stack{margin-top:10px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
</head>
<body>

<nav>
  <span class="brand"><span class="dot"></span>DataLake · NYC Taxi × Météo</span>
  <a href="#couches">Pipeline</a>
  {% for ds in payload.datasets %}{% set i = loop.index0 %}
  <a href="#apercu-{{i}}">Aperçu</a>
  <a href="#analyse1-{{i}}">Suppléments</a>
  <a href="#analyse2-{{i}}">Flux</a>
  <a href="#analyse3-{{i}}">Prix/km</a>
  <a href="#analyse4-{{i}}">Activité</a>
  <a href="#analyse5-{{i}}">Météo</a>
  {% endfor %}
</nav>

<header>
  <div class="kicker">Pipeline médallion · Spark · MinIO · Viridis</div>
  <h1>Les taxis <em>New-Yorkais</em>,<br>dix-sept ans de schémas réconciliés</h1>
  <p class="sub">
    Yellow (2009), green et fhv (2016)&nbsp;: les fichiers TLC changent de schéma au fil des ans
    (GPS brut avant juillet&nbsp;2016, identifiants de zone ensuite, suppléments apparus
    progressivement). Un pipeline en une seule commande&nbsp;: ingestion telle quelle dans un stockage
    objet, réconciliation distribuée avec Spark (<code>{{ payload.spark_master }}</code>),
    agrégats métier, puis ce dashboard statique — habillé avec la palette
    <code>#264653 · #2a9d8f · #e9c46a · #f4a261 · #e76f51</code>, heatmap en
    <code>viridis</code> 100 pas, du clair au foncé.
  </p>
  <div class="badges">
    <span class="badge"><span class="sw" style="background:#cd7f32"></span>Bronze : parquets bruts <b>tels quels</b></span>
    <span class="badge"><span class="sw" style="background:#c0c5ce"></span>Silver : schéma canonique typé</span>
    <span class="badge"><span class="sw" style="background:var(--sand)"></span>Gold : un mart JSON par analyse</span>
    <span class="badge mono">make run SAMPLE=3</span>
  </div>
</header>

<main>

<section id="couches">
  <div class="sec-head"><span class="idx">01</span><h2>Le pipeline en trois couches</h2></div>
  <p class="lead">Le brut est persisté <b>avant toute transformation</b>, puis raffiné couche par couche.
     Chaque étape tourne sur le cluster Spark (master + worker), jamais en local.</p>
  <div class="layers">
    <div class="layer" style="--tagc:var(--bronze)">
      <span class="tag">Bronze</span>
      <h3>Persistance du brut</h3>
      <p>Chaque parquet est copié <b>octet pour octet</b> vers
         <span class="mono">bronze/&lt;vehicle_type&gt;/&lt;year&gt;/&lt;month&gt;/</span>.</p>
      <ul>
        <li>ingestion idempotente (déjà présent → sauté)</li>
        <li>manifeste JSON cumulé dans <span class="mono">bronze/_manifest/</span></li>
        <li>météo stub : <span class="mono">bronze/weather/&lt;year&gt;/</span></li>
      </ul>
    </div>
    <div class="arrow">➜</div>
    <div class="layer" style="--tagc:var(--silver)">
      <span class="tag">Silver</span>
      <h3>Réconciliation &amp; typage</h3>
      <p>Schémas legacy (2009) et modernes fusionnés vers un modèle canonique unique.</p>
      <ul>
        <li>suppléments absents avant introduction → <b>null</b>, jamais 0</li>
        <li>horodatages corrompus écartés (fenêtre bornée)</li>
        <li>Parquet partitionné vehicle_type/year/month sur <span class="mono">s3a://silver/</span></li>
      </ul>
    </div>
    <div class="arrow">➜</div>
    <div class="layer" style="--tagc:var(--gold)">
      <span class="tag">Gold</span>
      <h3>Agrégats métier</h3>
      <p>Un mart JSON par analyse du notebook : suppléments, flux de zones, prix/km,
         activité jour×heure, écart météo (en attente).</p>
      <ul>
        <li><span class="mono">s3a://gold/</span> puis export vers ce site</li>
        <li>agrégats légers → dashboard 100% statique</li>
        <li>vérifiable dans la console MinIO (:9001)</li>
      </ul>
    </div>
  </div>
  <div class="cmd"><span class="cmt"># tout le pipeline, une seule commande :</span><br>make run <span class="cmt"># ajouter SAMPLE=3 pour ne traiter que 3 fichiers</span></div>
</section>

{% for ds in payload.datasets %}{% set i = loop.index0 %}
<section id="apercu-{{i}}">
  <div class="sec-head"><span class="idx">02</span><h2>Vue d'ensemble{% if ds.meta.sample_mode %} <small style="color:var(--sand)">(mode échantillon)</small>{% endif %}</h2></div>
  <p class="lead">Données ingérées depuis <span class="mono">{{ ds.meta.source_dir or "data/" }}</span>, traitées sur
     <span class="mono">{{ ds.meta.spark_master }}</span>. Généré le {{ ds.meta.genere_le[:10] }}.</p>
  <div class="kpis">
    <div class="kpi" style="--kc:var(--teal)"><div class="v" data-kpi="total-{{i}}"></div><div class="l">courses analysées</div></div>
    <div class="kpi" style="--kc:var(--teal)"><div class="v" data-kpi="periode-{{i}}"></div><div class="l">période couverte</div></div>
    <div class="kpi" style="--kc:var(--sand)"><div class="v" data-kpi="annees-{{i}}"></div><div class="l">années de données</div></div>
    <div class="kpi" style="--kc:var(--orange)"><div class="v" data-kpi="vehicules-{{i}}"></div><div class="l">types de véhicules</div></div>
    <div class="kpi" style="--kc:#7fb2c4"><div class="v" data-kpi="taille-{{i}}"></div><div class="l">de parquet brut ingéré</div></div>
  </div>
  <div class="duo">
    <div>
      <div class="chart-title"><b>Courses par type de véhicule</b><span>cliquez la légende pour masquer une part</span></div>
      <div id="donut-{{i}}" class="chart chart-pad" style="height:320px"></div>
    </div>
    <div>
      <div class="chart-title"><b>Courses par année</b><span>toutes périodes ingérées confondues</span></div>
      <div id="baran-{{i}}" class="chart chart-pad" style="height:320px"></div>
    </div>
  </div>
</section>

<section id="analyse1-{{i}}">
  <div class="sec-head"><span class="idx">03</span><h2>Évolution des suppléments tarifaires</h2></div>
  <blockquote>«&nbsp;Pour chaque supplément apparu progressivement dans le schéma, montrer son évolution
     dans le temps, par type de véhicule.&nbsp;»</blockquote>
  <div class="controls">
    <label>Véhicules</label>
    <div class="chips" id="veh-chips-{{i}}"></div>
    <label>Métrique</label>
    <div class="seg" id="met-seg-{{i}}">
      <button data-v="moyenne" class="on">Moyenne $/course</button>
      <button data-v="total">Total collecté</button>
    </div>
  </div>
  <p class="hint">Couleur = supplément · trait plein vs pointillé = véhicule · cliquez la légende pour masquer/afficher chaque courbe.</p>
  <div id="surcharge-{{i}}" class="chart" style="height:440px"></div>
  <div class="takeaway" id="tk-surcharge-{{i}}"></div>
</section>

<section id="analyse2-{{i}}">
  <div class="sec-head"><span class="idx">04</span><h2>Flux de prises en charge / déposes</h2></div>
  <blockquote>«&nbsp;Visualiser les flux de courses entre zones de départ et d'arrivée.&nbsp;»</blockquote>
  <div class="controls">
    <label>Visualisation</label>
    <div class="seg" id="flow-seg-{{i}}">
      <button data-v="chord" class="on">Corde</button>
      <button data-v="sankey">Sankey</button>
      <button data-v="bars">Top départs</button>
    </div>
  </div>
  <div id="chord-{{i}}" class="chart" style="height:580px"></div>
  <div class="takeaway" id="tk-chord-{{i}}"></div>
</section>

<section id="analyse3-{{i}}">
  <div class="sec-head"><span class="idx">05</span><h2>Prix au km par année et zone de départ</h2></div>
  <blockquote>«&nbsp;Un ridgeline plot montrant l'évolution des prix par km au fil des années, pour une zone
     de départ donnée.&nbsp;»</blockquote>
  <div class="controls">
    <label>Ridgeline — zone</label>
    <select id="zone-sel-{{i}}"></select>
  </div>
  <div id="ridge-{{i}}" class="chart" style="height:520px"></div>
  <div class="takeaway" id="tk-ridge-{{i}}"></div>

  <div class="chart-title" style="margin-top:34px"><b>Comparateur de zones</b><span>prix/km moyen pondéré par année — cochez plusieurs zones pour les superposer</span></div>
  <div class="controls">
    <label>Zones</label>
    <div class="chips" id="zone-chips-{{i}}"></div>
  </div>
  <div id="cmpzone-{{i}}" class="chart" style="height:400px"></div>
  <div class="takeaway" id="tk-cmpzone-{{i}}"></div>
</section>

<section id="analyse4-{{i}}">
  <div class="sec-head"><span class="idx">06</span><h2>Fréquence des courses : jour × heure</h2></div>
  <blockquote>«&nbsp;Une fonction qui, pour une année donnée en paramètre, produit une heatmap (jour de la
     semaine × heure) de la fréquence des courses, pour chaque type de véhicule.&nbsp;»</blockquote>
  <div class="controls">
    <label>Année</label>
    <select id="an-sel-{{i}}"></select>
    <label>Véhicule</label>
    <select id="vt-sel-{{i}}"></select>
  </div>
  <div id="heat-{{i}}" class="chart" style="height:450px"></div>
  <div class="takeaway" id="tk-heat-{{i}}"></div>

  <div class="chart-title" style="margin-top:34px"><b>Profil horaire</b><span>somme des 7 jours — tous les véhicules de l'année sélectionnée, comparables d'un coup d'œil</span></div>
  <div id="profil-{{i}}" class="chart" style="height:330px"></div>
  <div class="takeaway" id="tk-profil-{{i}}"></div>
</section>

<section id="analyse5-{{i}}">
  <div class="sec-head"><span class="idx">07</span><h2>Écart de prix selon la météo</h2></div>
  <blockquote>«&nbsp;Comparer le prix des courses (par km) selon les conditions météo au moment de la course,
     par rapport au prix moyen général.&nbsp;»</blockquote>
  <div id="meteo-{{i}}"></div>
</section>
{% endfor %}

</main>

<footer>
  Pipeline : ingestion → MinIO bronze/silver/gold → PySpark sur {{ payload.spark_master }} → dashboard statique.
  <div class="stack">
    <span class="badge">Docker Compose</span><span class="badge">Spark 3.5 master + worker</span>
    <span class="badge">MinIO S3</span><span class="badge">ECharts</span>
    <span class="badge">Généré le {{ payload.genere_le }}</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script>window.__PAYLOAD__ = {{ payload_json }};</script>
<script>
const P = window.__PAYLOAD__;
const nf = new Intl.NumberFormat('fr-FR');
const fmt = n => nf.format(n);
const charts = [];
const cache = {};
function mk(id){
  if (!cache[id]) { cache[id] = echarts.init(document.getElementById(id)); charts.push(cache[id]); }
  return cache[id];
}
window.addEventListener('resize', () => charts.forEach(c => c.resize()));

const SUP_COLORS = {
  'extra':'#e9c46a', 'mta_tax':'#2a9d8f', 'improvement_surcharge':'#f4a261',
  'congestion_surcharge':'#e76f51', 'airport_fee':'#8ecfc3', 'cbd_convenience_fee':'#7fb2c4'
};
const SUP_LABELS = {
  'extra':'Extra', 'mta_tax':'MTA tax', 'improvement_surcharge':'Improvement',
  'congestion_surcharge':'Congestion', 'airport_fee':'Airport fee', 'cbd_convenience_fee':'CBD fee'
};
const VIRIDIS = [
'#fde725','#f8e621','#f1e51d','#ece51b','#e5e419','#dfe318','#d8e219','#d0e11c',
'#cae11f','#c2df23','#bddf26','#b5de2b','#addc30','#a8db34','#a0da39','#9bd93c',
'#93d741','#8ed645','#86d549','#7fd34e','#7ad151','#73d056','#6ece58','#67cc5c',
'#60ca60','#5cc863','#56c667','#52c569','#4cc26c','#48c16e','#42be71','#3dbc74',
'#3aba76','#35b779','#32b67a','#2eb37c','#2ab07f','#28ae80','#25ac82','#24aa83',
'#22a785','#20a486','#1fa287','#1fa088','#1f9e89','#1e9b8a','#1f998a','#1f968b',
'#20938c','#20928c','#218f8d','#228d8d','#238a8d','#24878e','#25858e','#26828e',
'#26818e','#277e8e','#287c8e','#29798e','#2a768e','#2b748e','#2c718e','#2d708e',
'#2e6d8e','#306a8e','#31688e','#32658e','#33638d','#34608d','#365d8d','#375b8d',
'#38588c','#39558c','#3b528b','#3c508b','#3d4d8a','#3e4989','#3f4788','#414487',
'#424186','#433e85','#443a83','#453882','#463480','#46327e','#472e7c','#472c7a',
'#482878','#482475','#482173','#481d6f','#481b6d','#481769','#471365','#471063',
'#460b5e','#46085c','#450457','#440154'];
const PALETTE = ['#e9c46a','#2a9d8f','#457b8d','#f4a261','#e76f51'];
function hex2rgb(h){ return [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)]; }
function stops_color(stops, t){
  t = Math.max(0, Math.min(1, t));
  const x = t * (stops.length - 1), k = Math.min(Math.floor(x), stops.length - 2), f = x - k;
  const a = hex2rgb(stops[k]), b = hex2rgb(stops[k+1]);
  return `rgb(${Math.round(a[0]+(b[0]-a[0])*f)},${Math.round(a[1]+(b[1]-a[1])*f)},${Math.round(a[2]+(b[2]-a[2])*f)})`;
}
function vcolor(t){ return stops_color(VIRIDIS, t); }
function spread(n){ return Array.from({length:n}, (_,j) => stops_color(PALETTE, n > 1 ? j/(n-1) : 0)); }
function chipBox(elId, values, onChange, opts={}){
  const box = document.getElementById(elId);
  const cols = spread(values.length || 1);
  values.forEach((v, j) => {
    const lab = document.createElement('label');
    lab.className = 'chip';
    lab.style.setProperty('--cc', opts.color === false ? undefined : cols[j]);
    const inp = document.createElement('input');
    inp.type = 'checkbox'; inp.value = v; inp.checked = true;
    inp.addEventListener('change', () => onChange());
    const sp = document.createElement('span'); sp.textContent = opts.fmt ? opts.fmt(v) : v;
    lab.append(inp, sp); box.appendChild(lab);
  });
  return () => [...box.querySelectorAll('input:checked')].map(x => x.value);
}
function segCtl(elId, onChange){
  const seg = document.getElementById(elId);
  seg.querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
    seg.querySelectorAll('button').forEach(x => x.classList.remove('on'));
    b.classList.add('on'); onChange(b.dataset.v);
  }));
  return () => seg.querySelector('button.on').dataset.v;
}
function dashFor(idx){ return idx === 0 ? null : [8, 5]; }

const AX = { axisLabel:{color:'#9fb8bc'}, axisLine:{lineStyle:{color:'rgba(255,255,255,.12)'}},
             splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} };
const BASE = {
  backgroundColor:'transparent',
  textStyle:{ color:'#eef4f4', fontFamily:'inherit' },
};

P.datasets.forEach((ds, i) => {

  /* ---------- KPI ---------- */
  document.querySelector(`[data-kpi="total-${i}"]`).textContent = fmt(ds.kpis.total_courses);
  document.querySelector(`[data-kpi="periode-${i}"]`).textContent =
    `${ds.kpis.periode?.debut || '?'} → ${ds.kpis.periode?.fin || '?'}`;
  document.querySelector(`[data-kpi="annees-${i}"]`).textContent =
    Object.keys(ds.kpis.par_annee).join(', ') || 'n/a';
  document.querySelector(`[data-kpi="vehicules-${i}"]`).textContent =
    Object.keys(ds.kpis.par_vehicule).join(', ') || 'n/a';
  const go = ds.meta.taille_octets;
  document.querySelector(`[data-kpi="taille-${i}"]`).textContent =
    go ? (go / 1e9).toFixed(2).replace('.', ',') + ' Go' : 'n/a';

  /* ---------- Vue d'ensemble : donut véhicules ---------- */
  {
    const ent = Object.entries(ds.kpis.par_vehicule).sort((a,b) => b[1]-a[1]);
    const cols = spread(ent.length);
    const total = ent.reduce((s,e) => s+e[1], 0);
    mk(`donut-${i}`).setOption({
      ...BASE,
      tooltip:{ formatter:p => `<b>${p.name}</b><br>${fmt(p.value)} courses (${p.percent}%)` },
      legend:{ bottom:0, textStyle:{color:'#9fb8bc'}, icon:'circle' },
      title:{ text:fmt(total), subtext:'courses', left:'center', top:'38%',
              textStyle:{color:'#eef4f4', fontSize:22, fontWeight:600, fontFamily:'JetBrains Mono'},
              subtextStyle:{color:'#9fb8bc'} },
      series:[{
        type:'pie', radius:['52%','74%'], center:['50%','44%'],
        itemStyle:{ borderColor:'#1b313b', borderWidth:3, borderRadius:5 },
        label:{show:false},
        data: ent.map(([k,v], j) => ({ name:k, value:v, itemStyle:{color:cols[j]} }))
      }]
    });
  }

  /* ---------- Vue d'ensemble : barres par année ---------- */
  {
    const ans = Object.entries(ds.kpis.par_annee).sort((a,b) => a[0].localeCompare(b[0]));
    mk(`baran-${i}`).setOption({
      ...BASE,
      tooltip:{ trigger:'axis', axisPointer:{type:'shadow'} },
      grid:{ left:70, right:24, top:20, bottom:40 },
      xAxis:{ type:'category', data:ans.map(a=>a[0]),
              axisLabel:{color:'#9fb8bc'}, axisLine:{lineStyle:{color:'rgba(255,255,255,.12)'}} },
      yAxis:{ type:'value', axisLabel:{color:'#9fb8bc', formatter:v=>fmt(v)},
              splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} },
      series:[{ type:'bar', barMaxWidth:46,
        data:ans.map((a,j,arr) => ({ value:a[1],
          itemStyle:{ color:vcolor(arr.length>1 ? j/(arr.length-1) : .5), borderRadius:[6,6,0,0] } })),
        label:{ show:true, position:'top', color:'#9fb8bc', fontSize:10,
                formatter:p=>fmt(p.value) } }]
    });
  }

  /* ---------- Analyse 1 : suppléments tarifaires ---------- */
  {
    const vehicules = [...new Set(ds.surcharges.rows.map(r => r.vehicle_type))].sort();
    const getSel = chipBox(`veh-chips-${i}`, vehicules, draw, {fmt: v=>v});
    const getMet = segCtl(`met-seg-${i}`, draw);
    const annees = [...new Set(ds.surcharges.rows.map(r => r.annee))].sort((a,b)=>a-b);

    function draw(){
      const veSel = getSel(), met = getMet();
      const field = met === 'total' ? '_total' : '_moyen';
      const series = [];
      let anyData = false;
      vehicules.forEach(v => {
        if (!veSel.includes(v)) return;
        const vi = veSel.indexOf(v);
        const rows = Object.fromEntries(ds.surcharges.rows.filter(r => r.vehicle_type === v).map(r => [r.annee, r]));
        ds.surcharges.supplements.forEach(s => {
          if (!ds.surcharges.rows.some(r => r.vehicle_type === v && r[s + field] !== null)) return;
          anyData = true;
          series.push({
            name: vehicules.length > 1 ? `${SUP_LABELS[s]||s} · ${v}` : (SUP_LABELS[s]||s),
            type:'line', smooth:true, symbol:'circle', symbolSize:6, connectNulls:false,
            data: annees.map(a => rows[a] ? rows[a][s+field] : null),
            itemStyle:{ color:SUP_COLORS[s] || '#9fb8bc' },
            lineStyle:{ width:2.4, type:dashFor(vi), color:SUP_COLORS[s] || '#9fb8bc' }
          });
        });
      });
      const yName = met === 'total' ? '$ cumulés' : '$/course';
      mk(`surcharge-${i}`).setOption({
        ...BASE,
        tooltip:{ trigger:'axis', valueFormatter:v=>v==null?'—':(met==='total'?'$'+fmt(v):'$'+Number(v).toFixed(3)) },
        legend:{ top:0, type:'scroll', textStyle:{color:'#9fb8bc'}, icon:'roundRect' },
        grid:{ left:64, right:30, top:56, bottom:45 },
        xAxis:{ type:'category', data:annees, ...AX },
        yAxis:{ type:'value', name:yName, nameTextStyle:{color:'#9fb8bc'}, ...AX },
        series
      }, true);
      if (!anyData){ mk(`surcharge-${i}`).clear(); }
      const dispo = ds.surcharges.supplements.filter(s =>
        ds.surcharges.rows.some(r => r[s + '_moyen'] !== null));
      document.getElementById(`tk-surcharge-${i}`).innerHTML = dispo.length
        ? `Sur cet extrait, les composants renseignés sont : <b>${dispo.map(s=>SUP_LABELS[s]).join(', ')}</b>. ` +
          `Les autres restent à <b>null</b> : ils n'existaient pas encore à ces dates, ce qui n'équivaut pas à $0.`
        : `Aucun supplément renseigné dans cet échantillon.`;
    }
    draw();
  }

  /* ---------- Analyse 2 : flux entre zones (corde / sankey / barres) ---------- */
  {
    const fz = ds.flux_zones;
    const box = document.getElementById(`chord-${i}`);
    const getFlow = segCtl(`flow-seg-${i}`, drawFlow);

    function renderChord(){
      if (!fz.nodes.length){
        box.innerHTML = '<p class="empty">Aucune course avec identifiants de zone dans cet échantillon ' +
                        '(les fichiers 2009 contiennent du GPS brut, pas de LocationID).</p>';
        document.getElementById(`tk-chord-${i}`).innerHTML = '';
        return true;
      }
      const nodeIds = new Set(fz.nodes.map(n => n.id));
      const links = fz.links.filter(l => nodeIds.has(l.source) && nodeIds.has(l.target));
      const maxPick = Math.max(...fz.nodes.map(n => n.pickups), 1);
      const maxLink = links.length ? links[0].count : 1;
      const cols = spread(fz.nodes.length);
      mk(`chord-${i}`).setOption({
        ...BASE,
        title:{ text:`${fmt(fz.courses_zonees)} courses zonées`, left:'center', top:6,
                textStyle:{color:'#9fb8bc', fontSize:13, fontWeight:'normal'} },
        tooltip:{ formatter:p => p.dataType === 'edge'
          ? `<b>Zone ${p.data.source.replace('Zone ','')} → Zone ${p.data.target.replace('Zone ','')}</b><br>${fmt(p.data.value)} courses`
          : `<b>${p.name}</b><br>${fmt(fz.nodes.find(n=>'Zone '+n.id===p.name)?.pickups ?? 0)} départs` },
        series:[{
          type:'graph', layout:'circular', circular:{ rotateLabel:true },
          data: fz.nodes.map((n,j) => ({ name:'Zone '+n.id,
            symbolSize: 8 + 26*n.pickups/maxPick,
            itemStyle:{ color:cols[j], borderColor:'#13222a', borderWidth:2 } })),
          links: links.map(l => ({ source:'Zone '+l.source, target:'Zone '+l.target,
            value:l.count, lineStyle:{ width: 1 + 6*l.count/maxLink,
              color:'#f4a261', opacity:.5, curveness:.35 } })),
          emphasis:{ focus:'adjacency', lineStyle:{ opacity:1, width:5 } },
          label:{ color:'#eef4f4', fontSize:11 },
          roam:true
        }]
      }, true);
      document.getElementById(`tk-chord-${i}`).innerHTML =
        `L'axe dominant est <b>Zone ${links[0].source} → Zone ${links[0].target}</b> avec ` +
        `${fmt(links[0].count)} courses (${fmt(fz.courses_non_zonees)} courses hors périmètre zoné).`;
      return true;
    }

    function renderSankey(){
      if (!fz.nodes.length) return renderChord();
      const nodeIds = new Set(fz.nodes.map(n => n.id));
      const links = fz.links.filter(l => nodeIds.has(l.source) && nodeIds.has(l.target));
      const cols = spread(fz.nodes.length);
      try {
        mk(`chord-${i}`).setOption({
          ...BASE,
          title:{ text:`${fmt(fz.courses_zonees)} courses zonées`, left:'center', top:6,
                  textStyle:{color:'#9fb8bc', fontSize:13, fontWeight:'normal'} },
          tooltip:{ trigger:'item' },
          series:[{
            type:'sankey', left:20, right:150, top:40, bottom:20,
            nodeWidth:14, nodeGap:12,
            data: fz.nodes.map((n,j) => ({ name:'Zone '+n.id, value:n.pickups,
              itemStyle:{ color:cols[j], borderColor:'transparent' } })),
            links: links.map(l => ({ source:'Zone '+l.source, target:'Zone '+l.target, value:l.count })),
            label:{ color:'#eef4f4', fontSize:11 },
            lineStyle:{ color:'gradient', opacity:.35, curveness:.5 },
            emphasis:{ focus:'adjacency' }
          }]
        }, true);
      } catch(e){
        box.innerHTML = '<p class="empty">Vue Sankey indisponible pour ce graphe (flux cycliques).</p>';
      }
      return true;
    }

    function renderBars(){
      if (!fz.nodes.length) return renderChord();
      const tops = [...fz.nodes].sort((a,b) => b.pickups-a.pickups).slice(0, 12);
      const cols = spread(tops.length);
      mk(`chord-${i}`).setOption({
        ...BASE,
        title:{ text:`${fmt(fz.courses_zonees)} courses zonées — départs par zone (top ${tops.length})`,
                left:'center', top:6, textStyle:{color:'#9fb8bc', fontSize:13, fontWeight:'normal'} },
        tooltip:{ trigger:'axis', axisPointer:{type:'shadow'},
                  formatter:p => `<b>${p[0].name}</b><br>${fmt(p[0].value)} départs` },
        grid:{ left:90, right:50, top:40, bottom:30 },
        xAxis:{ type:'value', axisLabel:{color:'#9fb8bc', formatter:v=>fmt(v)},
                splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} },
        yAxis:{ type:'category', data:tops.map(n=>'Zone '+n.id).reverse(),
                axisLabel:{color:'#eef4f4'}, axisLine:{show:false}, axisTick:{show:false} },
        series:[{ type:'bar', barMaxWidth:22,
          data:[...tops].reverse().map((n,j) => ({ value:n.pickups,
            itemStyle:{ color:cols[tops.length-1-j], borderRadius:[0,6,6,0] } })) }]
      }, true);
      return true;
    }

    function drawFlow(){
      const v = getFlow();
      if (v === 'chord') renderChord();
      else if (v === 'sankey') renderSankey();
      else renderBars();
    }
    drawFlow();
  }

  /* ---------- Analyse 3 : ridgeline prix / km ---------- */
  {
    const zones = ds.prix_km.zones;
    const sel = document.getElementById(`zone-sel-${i}`);
    if (!zones.length){
      sel.closest('.controls').style.display = 'none';
      document.getElementById(`ridge-${i}`).innerHTML =
        '<p class="empty">Pas assez de données tarifaires zonées dans cet échantillon.</p>';
      document.getElementById(`tk-ridge-${i}`).innerHTML = '';
      const cmpBox = document.getElementById(`cmpzone-${i}`);
      cmpBox.innerHTML = '<p class="empty">Comparateur indisponible sans zones.</p>';
      document.getElementById(`tk-cmpzone-${i}`).innerHTML = '';
    } else {
      const H = 1;
      const centers = ds.prix_km.bins.map((b, k) => k + 0.5);

      function drawRidge(){
        const zone = +sel.value;
        const rows = ds.prix_km.rows.filter(r => r.zone === zone);
        const annees = [...new Set(rows.map(r => r.annee))].sort((a,b)=>a-b);
        const maxCount = Math.max(...rows.map(r => Math.max(...r.hist)), 1);
        const series = [];
        annees.forEach((a, j) => {
          const r = rows.find(x => x.annee === a);
          const off = j * H;
          const col = vcolor(annees.length > 1 ? j/(annees.length-1) : .5);
          const pts = [[centers[0]-0.55, off]]
            .concat(centers.map((c, k) => [c, off + (r.hist[k]/maxCount)*0.92]))
            .concat([[centers[centers.length-1]+0.55, off]]);
          series.push({
            type:'line', smooth:true, symbol:'none', z:j+1, name:String(a), data:pts,
            lineStyle:{ width:1.6, color:col },
            areaStyle:{ color:col.replace('rgb','rgba').replace(')', ',.25)') }
          });
        });
        mk(`ridge-${i}`).setOption({
          ...BASE,
          tooltip:{ formatter:p => `Année ${p.seriesName} · ` +
            `${ds.prix_km.bins[Math.min(Math.max(Math.floor(p.value[0]),0), ds.prix_km.bins.length-1)]}` },
          grid:{ left:60, right:30, top:20, bottom:50 },
          xAxis:{ type:'value', min:-1, max:ds.prix_km.bins.length,
                  axisLabel:{ color:'#9fb8bc', formatter:v => Number.isInteger(v) ? v+'$' : '' },
                  splitLine:{ show:false } },
          yAxis:{ type:'value', max:(annees.length)*H + 0.6,
                  axisLabel:{ show:false }, splitLine:{ show:false } },
          series
        }, true);
        const last = rows.filter(r => r.annee === annees[annees.length-1]);
        const moy = last.length ? last.reduce((s,r)=>s+r.prix_km_moyen*r.courses,0) /
                    last.reduce((s,r)=>s+r.courses,0) : null;
        document.getElementById(`tk-ridge-${i}`).innerHTML =
          `Distribution des prix/km pour la <b>Zone ${zone}</b>, une crête par année ` +
          `(de ${annees[0]} en bas — clair — à ${annees[annees.length-1]} en haut — foncé)` +
          (moy != null ? `, moyenne ${String(moy).replace('.', ',')} $/km la dernière année.` : '.');
      }
      zones.forEach(z => sel.add(new Option('Zone ' + z, z)));
      sel.addEventListener('change', drawRidge);
      drawRidge();

      /* --- Comparateur de zones --- */
      const cmpZones = zones.slice(0, Math.min(zones.length, 6));
      const getCmp = chipBox(`zone-chips-${i}`, cmpZones, drawCmp, {fmt: v=>'Zone '+v});
      function drawCmp(){
        const picked = getCmp().map(Number);
        const annees = [...new Set(ds.prix_km.rows.filter(r=>picked.includes(r.zone)).map(r => r.annee))]
                       .sort((a,b)=>a-b);
        const cols = spread(picked.length);
        const series = picked.map((z, j) => ({
          name:'Zone ' + z, type:'line', smooth:true, symbol:'circle', symbolSize:7,
          data: annees.map(a => {
            const r = ds.prix_km.rows.find(x => x.zone===z && x.annee===a);
            return r && r.courses ? +(r.prix_km_moyen.toFixed(3)) : null;
          }),
          itemStyle:{color:cols[j]}, lineStyle:{width:2.6, color:cols[j]},
          emphasis:{ focus:'series' }
        }));
        mk(`cmpzone-${i}`).setOption({
          ...BASE,
          tooltip:{ trigger:'axis', valueFormatter:v=>v==null?'—':String(v).replace('.', ',')+' $/km' },
          legend:{ top:0, textStyle:{color:'#9fb8bc'} },
          grid:{ left:64, right:30, top:44, bottom:45 },
          xAxis:{ type:'category', data:annees, ...AX },
          yAxis:{ type:'value', name:'$/km', nameTextStyle:{color:'#9fb8bc'}, ...AX },
          series
        }, true);
        const flat = ds.prix_km.rows.filter(r => picked.includes(r.zone));
        const best = flat.length
          ? flat.reduce((m,r) => r.prix_km_moyen < m.prix_km_moyen ? r : m)
          : null;
        document.getElementById(`tk-cmpzone-${i}`).innerHTML = best
          ? `Sur les années couvertes, la zone la moins chère au km parmi la sélection est la ` +
            `<b>Zone ${best.zone}</b> (${String(best.prix_km_moyen).replace('.', ',')} $/km en ${best.annee}).`
          : '';
      }
      drawCmp();
    }
  }

  /* ---------- Analyse 4 : heatmap jour x heure + profil horaire ---------- */
  {
    const anSel = document.getElementById(`an-sel-${i}`);
    const vtSel = document.getElementById(`vt-sel-${i}`);
    const annees = Object.keys(ds.heatmap).sort();
    annees.forEach(a => anSel.add(new Option(a, a)));

    function fillVeh(){
      vtSel.innerHTML = '';
      Object.keys(ds.heatmap[anSel.value] || {}).sort().forEach(v => vtSel.add(new Option(v, v)));
    }
    function draw(){
      const cell = (ds.heatmap[anSel.value] || {})[vtSel.value];
      if (!cell){ return; }
      let maxV = 0, bj=0, bh=0;
      cell.matrice.forEach((row,j)=>row.forEach((v,h)=>{ if(v>maxV){maxV=v;bj=j;bh=h;} }));
      const data = [];
      cell.matrice.forEach((row,j)=>row.forEach((v,h)=>data.push([h,j,v])));
      mk(`heat-${i}`).setOption({
        ...BASE,
        tooltip:{ position:'top',
          formatter:p=>`${cell.jours[p.value[1]]} ${p.value[0]}h : ${fmt(p.value[2])} courses` },
        grid:{ left:80, right:20, top:20, bottom:70 },
        xAxis:{ type:'category', data:cell.heures.map(h=>h+'h'), splitArea:{show:true},
                axisLine:{show:false}, axisTick:{show:false},
                axisLabel:{color:'#9fb8bc', interval:1} },
        yAxis:{ type:'category', data:cell.jours, inverse:true,
                axisLine:{show:false}, axisTick:{show:false}, axisLabel:{color:'#eef4f4'} },
        visualMap:{ min:0, max:maxV||1, calculable:false, orient:'horizontal', left:'center', bottom:6,
          textStyle:{color:'#9fb8bc'},
          inRange:{ color:['#fde725','#f8e621','#f1e51d','#ece51b','#e5e419','#dfe318','#d8e219','#d0e11c',
'#cae11f','#c2df23','#bddf26','#b5de2b','#addc30','#a8db34','#a0da39','#9bd93c',
'#93d741','#8ed645','#86d549','#7fd34e','#7ad151','#73d056','#6ece58','#67cc5c',
'#60ca60','#5cc863','#56c667','#52c569','#4cc26c','#48c16e','#42be71','#3dbc74',
'#3aba76','#35b779','#32b67a','#2eb37c','#2ab07f','#28ae80','#25ac82','#24aa83',
'#22a785','#20a486','#1fa287','#1fa088','#1f9e89','#1e9b8a','#1f998a','#1f968b',
'#20938c','#20928c','#218f8d','#228d8d','#238a8d','#24878e','#25858e','#26828e',
'#26818e','#277e8e','#287c8e','#29798e','#2a768e','#2b748e','#2c718e','#2d708e',
'#2e6d8e','#306a8e','#31688e','#32658e','#33638d','#34608d','#365d8d','#375b8d',
'#38588c','#39558c','#3b528b','#3c508b','#3d4d8a','#3e4989','#3f4788','#414487',
'#424186','#433e85','#443a83','#453882','#463480','#46327e','#472e7c','#472c7a',
'#482878','#482475','#482173','#481d6f','#481b6d','#481769','#471365','#471063',
'#460b5e','#46085c','#450457','#440154'] } },
        series:[{ type:'heatmap', data, label:{show:false},
          itemStyle:{ borderColor:'#1b313b', borderWidth:2 },
          emphasis:{ itemStyle:{ shadowBlur:10, shadowColor:'rgba(233,196,106,.6)' } } }]
      }, true);
      document.getElementById(`tk-heat-${i}`).innerHTML =
        `${anSel.value}, ${vtSel.value} : le créneau le plus chargé est ` +
        `<b>${cell.jours[bj]} autour de ${bh}h-${(bh+1)%24}h</b> (${fmt(maxV)} courses).`;
    }

    function drawProfil(){
      const yearData = ds.heatmap[anSel.value] || {};
      const vehs = Object.keys(yearData).sort();
      const heures = yearData[vehs[0]]?.heures || [];
      const cols = spread(vehs.length || 1);
      const series = vehs.map((v, j) => {
        const prof = heures.map((_, h) => yearData[v].matrice.reduce((s,row) => s + (row[h]||0), 0));
        return { name:v, type:'line', smooth:true, symbol:'circle', symbolSize:5,
                 data:prof, itemStyle:{color:cols[j]}, lineStyle:{width:2.6, color:cols[j]},
                 areaStyle:{ color:cols[j].replace('rgb','rgba').replace(')', ',.08)') } };
      });
      mk(`profil-${i}`).setOption({
        ...BASE,
        tooltip:{ trigger:'axis' },
        legend:{ top:0, textStyle:{color:'#9fb8bc'} },
        grid:{ left:70, right:24, top:40, bottom:40 },
        xAxis:{ type:'category', data:heures.map(h=>h+'h'), boundaryGap:false, ...AX },
        yAxis:{ type:'value', axisLabel:{color:'#9fb8bc', formatter:v=>fmt(v)},
                splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} },
        series
      }, true);
      let peak = null;
      vehs.forEach(v => {
        const prof = heures.map((_, h) => (ds.heatmap[anSel.value][v].matrice.reduce((s,row)=>s+(row[h]||0),0)));
        prof.forEach((val,h) => { if (!peak || val > peak.val) peak = {v, h, val}; });
      });
      document.getElementById(`tk-profil-${i}`).innerHTML = peak
        ? `En ${anSel.value}, toutes fenêtres horaires confondues, le pic absolu revient à ` +
          `<b>${peak.v}</b> à <b>${peak.h}h</b> (${fmt(peak.val)} courses sur la semaine). ` +
          `Les légendes sont cliquables pour isoler un véhicule.`
        : '';
    }

    anSel.addEventListener('change', () => { fillVeh(); draw(); drawProfil(); });
    vtSel.addEventListener('change', draw);
    fillVeh();
    draw();
    drawProfil();
  }

  /* ---------- Analyse 5 : météo ---------- */
  {
    const box = document.getElementById(`meteo-${i}`);
    if (ds.meteo.statut === 'en_attente'){
      box.innerHTML = `<div class="card warn"><div class="t">En attente de l'ingestion météo</div>
        <p style="color:var(--muted)">${ds.meteo.message}</p></div>`;
    } else {
      box.innerHTML = `<div class="card"><div class="t">Table météo disponible</div>
        <p style="color:var(--muted)">${ds.meteo.message}</p></div>`;
    }
  }

});
</script>
</body>
</html>
