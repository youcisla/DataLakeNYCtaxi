<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NYC Taxi × Météo : DataLake Bronze · Silver · Gold</title>
<style>
  :root{
    --bg:#0b1020; --panel:#121a2b; --panel2:#0f1626; --border:#1e2a41;
    --text:#dbe4f0; --muted:#8fa1ba; --accent:#ffb703; --accent2:#06d6a0;
    --blue:#118ab2; --rose:#ef476f; --violet:#9b5de5;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;line-height:1.55}
  .mono{font-family:ui-monospace,"Cascadia Code",Consolas,monospace}
  a{color:var(--accent)}
  nav{position:sticky;top:0;z-index:50;display:flex;gap:22px;align-items:center;padding:14px 28px;
      background:rgba(11,16,32,.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
  nav .brand{font-weight:700;color:var(--accent);letter-spacing:.4px}
  nav a{color:var(--muted);text-decoration:none;font-size:.92rem}
  nav a:hover{color:var(--text)}
  header{max-width:1150px;margin:0 auto;padding:70px 28px 40px}
  .kicker{color:var(--accent2);text-transform:uppercase;letter-spacing:2.5px;font-size:.78rem;font-weight:600}
  h1{font-size:clamp(2rem,5vw,3.3rem);line-height:1.12;margin:10px 0 14px}
  h1 em{color:var(--accent);font-style:normal}
  .sub{max-width:820px;color:var(--muted);font-size:1.06rem}
  .badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
  .badge{border:1px solid var(--border);background:var(--panel2);padding:7px 13px;border-radius:999px;
         font-size:.82rem;color:var(--muted)}
  .badge b{color:var(--text);font-weight:600}
  main{max-width:1150px;margin:0 auto;padding:20px 28px 60px}
  section{margin-top:64px}
  h2{font-size:1.65rem;margin-bottom:6px}
  h2 .num{color:var(--accent);margin-right:10px}
  .lead{color:var(--muted);margin-bottom:24px;max-width:850px}
  /* --- couches --- */
  .layers{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:14px;align-items:stretch;margin-top:26px}
  .layer{background:linear-gradient(160deg,var(--panel),var(--panel2));border:1px solid var(--border);
         border-radius:16px;padding:22px}
  .layer .tag{display:inline-block;font-size:.72rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;
              padding:4px 10px;border-radius:999px;margin-bottom:12px}
  .layer.bronze .tag{background:rgba(205,127,50,.16);color:#cd7f32}
  .layer.silver .tag{background:rgba(192,197,206,.14);color:#c0c5ce}
  .layer.gold  .tag{background:rgba(255,183,3,.15);color:var(--accent)}
  .layer h3{margin-bottom:8px;font-size:1.08rem}
  .layer p{color:var(--muted);font-size:.9rem}
  .layer ul{margin-top:12px;list-style:none}
  .layer li{font-size:.85rem;color:var(--muted);padding-left:18px;position:relative;margin-top:6px}
  .layer li::before{content:"◆";position:absolute;left:0;color:var(--accent2);font-size:.6rem;top:5px}
  .arrow{align-self:center;color:var(--accent);font-size:1.6rem}
  @media(max-width:900px){.layers{grid-template-columns:1fr}.arrow{transform:rotate(90deg);justify-self:center}}
  .cmd{margin-top:26px;background:#0a0f1d;border:1px solid var(--border);border-radius:12px;
       padding:16px 20px;color:#9fe8c8;overflow-x:auto;white-space:nowrap}
  .cmd .cmt{color:var(--muted)}
  /* --- KPI --- */
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-top:26px}
  .kpi{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px 20px}
  .kpi .v{font-size:1.7rem;font-weight:700;color:var(--accent)}
  .kpi .l{color:var(--muted);font-size:.84rem;margin-top:4px}
  /* --- analyses --- */
  blockquote{border-left:3px solid var(--accent);background:var(--panel2);border-radius:0 12px 12px 0;
             padding:14px 20px;color:var(--text);font-style:italic;margin-bottom:20px}
  .chart{width:100%;background:var(--panel);border:1px solid var(--border);border-radius:14px;margin-top:18px}
  .takeaway{margin-top:16px;background:rgba(6,214,160,.07);border:1px solid rgba(6,214,160,.25);
            border-radius:12px;padding:14px 18px;font-size:.95rem}
  .takeaway::before{content:"Lecture : ";color:var(--accent2);font-weight:600}
  .sw{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:7px;vertical-align:-1px}
  .selbar{display:flex;gap:14px;align-items:center;margin-top:18px;flex-wrap:wrap}
  .selbar label{color:var(--muted);font-size:.88rem}
  .selbar select{background:var(--panel);border:1px solid var(--border);border-radius:10px;
                 color:var(--text);padding:8px 12px;font-size:.92rem;outline:none}
  .card{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:24px;margin-top:18px}
  .card.warn{border-color:rgba(255,183,3,.35)}
  .card .t{font-weight:700;color:var(--accent);margin-bottom:8px}
  footer{border-top:1px solid var(--border);margin-top:80px;padding:34px 28px;text-align:center;
         color:var(--muted);font-size:.88rem}
  footer .stack{margin-top:8px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
</style>
</head>
<body>

<nav>
  <span class="brand">◆ DataLake · NYC Taxi × Météo</span>
  <a href="#couches">Les 3 couches</a>
  {% for ds in payload.datasets %}{% set i = loop.index0 %}
  <a href="#analyse1-{{i}}">Suppléments</a>
  <a href="#analyse2-{{i}}">Flux zones</a>
  <a href="#analyse3-{{i}}">Prix / km</a>
  <a href="#analyse4-{{i}}">Activité</a>
  <a href="#analyse5-{{i}}">Météo</a>
  {% endfor %}
</nav>

<header>
  <div class="kicker">Pipeline médallion · Spark sur master réel · MinIO</div>
  <h1>Les taxis <em>New-Yorkais</em>,<br>dix-sept ans de schémas réconciliés</h1>
  <p class="sub">
    Yellow (2009), green et fhv (2016)&nbsp;: les fichiers TLC changent de schéma au fil des ans
    (GPS brut avant juillet&nbsp;2016, identifiants de zone ensuite, suppléments apparus
    progressivement). Un pipeline en une seule commande&nbsp;: ingestion telle quelle dans un stockage
    objet, réconciliation distribuée avec Spark connecté à un vrai master
    (<code class="mono">{{ payload.spark_master }}</code>), agrégats métier, puis ce dashboard statique.
  </p>
  <div class="badges">
    <span class="badge"><span class="sw" style="background:#cd7f32"></span>Bronze : parquets bruts <b>tels quels</b> (MinIO)</span>
    <span class="badge"><span class="sw" style="background:#c0c5ce"></span>Silver : schéma canonique typé &amp; drift résolu</span>
    <span class="badge"><span class="sw" style="background:#ffb703"></span>Gold : un mart JSON par analyse (MinIO)</span>
    <span class="badge mono">make run SAMPLE=3</span>
  </div>
</header>

<main>

<section id="couches">
  <h2><span class="num">01</span>Le pipeline en trois couches</h2>
  <p class="lead">Le brut est persisté <b>avant toute transformation</b>, puis raffiné couche par couche.
     Chaque étape tourne sur le cluster Spark (master + worker), jamais en local.</p>
  <div class="layers">
    <div class="layer bronze">
      <span class="tag">Bronze</span>
      <h3>Persistance du brut</h3>
      <p>Chaque parquet est copié <b>octet pour octet</b> vers
         <span class="mono">bronze/&lt;vehicle_type&gt;/&lt;year&gt;/&lt;month&gt;/</span>,
         convention qui répond sans ouvrir les fichiers&nbsp;: quels types, quelles périodes,
         quel mois déjà ingéré.</p>
      <ul>
        <li>ingestion idempotente (déjà présent → sauté)</li>
        <li>manifeste JSON cumulé dans <span class="mono">bronze/_manifest/</span></li>
        <li>météo stub : <span class="mono">bronze/weather/&lt;year&gt;/</span></li>
      </ul>
    </div>
    <div class="arrow">➜</div>
    <div class="layer silver">
      <span class="tag">Silver</span>
      <h3>Réconciliation &amp; typage</h3>
      <p>Schemas legacy (2009) et modernes fusionnés vers un modèle canonique unique,
         GPS et LocationID conservés côte à côte.</p>
      <ul>
        <li>suppléments absents avant introduction → <b>null</b>, jamais 0</li>
        <li>horodatages corrompus écartés (fenêtre bornée)</li>
        <li>Parquet partitionné vehicle_type/year/month sur <span class="mono">s3a://silver/</span></li>
      </ul>
    </div>
    <div class="arrow">➜</div>
    <div class="layer gold">
      <span class="tag">Gold</span>
      <h3>Agrégats métier</h3>
      <p>Un mart JSON par analyse du notebook : suppléments, flux de zones, prix/km,
         activité jour×heure, écart météo (en attente).</p>
      <ul>
        <li><span class="mono">s3a://gold/</span> puis export vers ce site</li>
        <li>agrégats légers → dashboard 100% statique</li>
        <li>vérifiable dans la console MinIO (:9001)</li>
      </ul>
    </div>
  </div>
  <div class="cmd"><span class="cmt"># tout le pipeline, une seule commande :</span><br>make run <span class="cmt"># ajouter SAMPLE=3 pour ne traiter que 3 fichiers</span></div>
</section>

{% for ds in payload.datasets %}{% set i = loop.index0 %}
<section id="apercu-{{i}}">
  <h2><span class="num">02</span>Vue d'ensemble{% if ds.meta.sample_mode %} <small style="color:var(--rose)">(mode échantillon)</small>{% endif %}</h2>
  <p class="lead">Données ingérées depuis <span class="mono">{{ ds.meta.source_dir or "data/" }}</span>, traitées sur
     <span class="mono">{{ ds.meta.spark_master }}</span>. Généré le {{ ds.meta.genere_le[:10] }}.</p>
  <div class="kpis">
    <div class="kpi"><div class="v" data-kpi="total-{{i}}"></div><div class="l">courses analysées</div></div>
    <div class="kpi"><div class="v" data-kpi="periode-{{i}}"></div><div class="l">période couverte</div></div>
    <div class="kpi"><div class="v" data-kpi="annees-{{i}}"></div><div class="l">années de données</div></div>
    <div class="kpi"><div class="v" data-kpi="vehicules-{{i}}"></div><div class="l">types de véhicules</div></div>
    <div class="kpi"><div class="v" data-kpi="taille-{{i}}"></div><div class="l">de parquet brut ingéré</div></div>
  </div>
</section>

<section id="analyse1-{{i}}">
  <h2><span class="num">03</span>Évolution des suppléments tarifaires</h2>
  <blockquote>«&nbsp;Pour chaque supplément apparu progressivement dans le schéma, montrer son évolution
     dans le temps (montant moyen collecté), par type de véhicule.&nbsp;»</blockquote>
  <div class="selbar">
    <label for="veh-sel-{{i}}">Type de véhicule :</label>
    <select id="veh-sel-{{i}}"></select>
  </div>
  <div id="surcharge-{{i}}" class="chart" style="height:420px"></div>
  <div class="takeaway" id="tk-surcharge-{{i}}"></div>
</section>

<section id="analyse2-{{i}}">
  <h2><span class="num">04</span>Flux de prises en charge / déposes</h2>
  <blockquote>«&nbsp;Visualiser, sous forme de diagramme en corde, les flux de courses entre zones de départ
     et d'arrivée.&nbsp;»</blockquote>
  <div id="chord-{{i}}" class="chart" style="height:560px"></div>
  <div class="takeaway" id="tk-chord-{{i}}"></div>
</section>

<section id="analyse3-{{i}}">
  <h2><span class="num">05</span>Prix au km par année et zone de départ</h2>
  <blockquote>«&nbsp;Un ridgeline plot montrant l'évolution des prix par km au fil des années, pour une zone
     de départ donnée.&nbsp;»</blockquote>
  <div class="selbar">
    <label for="zone-sel-{{i}}">Zone de départ (LocationID) :</label>
    <select id="zone-sel-{{i}}"></select>
  </div>
  <div id="ridge-{{i}}" class="chart" style="height:520px"></div>
  <div class="takeaway" id="tk-ridge-{{i}}"></div>
</section>

<section id="analyse4-{{i}}">
  <h2><span class="num">06</span>Fréquence des courses : jour × heure</h2>
  <blockquote>«&nbsp;Une fonction qui, pour une année donnée en paramètre, produit une heatmap (jour de la
     semaine × heure) de la fréquence des courses, pour chaque type de véhicule.&nbsp;»</blockquote>
  <div class="selbar">
    <label for="an-sel-{{i}}">Année :</label>
    <select id="an-sel-{{i}}"></select>
    <label for="vt-sel-{{i}}">Véhicule :</label>
    <select id="vt-sel-{{i}}"></select>
  </div>
  <div id="heat-{{i}}" class="chart" style="height:430px"></div>
  <div class="takeaway" id="tk-heat-{{i}}"></div>
</section>

<section id="analyse5-{{i}}">
  <h2><span class="num">07</span>Écart de prix selon la météo</h2>
  <blockquote>«&nbsp;Comparer le prix des courses (par km) selon les conditions météo au moment de la course,
     par rapport au prix moyen général.&nbsp;»</blockquote>
  <div id="meteo-{{i}}"></div>
</section>
{% endfor %}

</main>

<footer>
  Pipeline : ingestion → MinIO bronze/silver/gold → PySpark sur {{ payload.spark_master }} → dashboard statique.
  <div class="stack">
    <span class="badge">Docker Compose</span><span class="badge">Spark 3.5 master + worker</span>
    <span class="badge">MinIO S3</span><span class="badge">ECharts</span>
    <span class="badge">Généré le {{ payload.genere_le }}</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script>window.__PAYLOAD__ = {{ payload_json }};</script>
<script>
const P = window.__PAYLOAD__;
const nf = new Intl.NumberFormat('fr-FR');
const fmt = n => nf.format(n);
const charts = [];
const cache = {};
function mk(id){
  if (!cache[id]) { cache[id] = echarts.init(document.getElementById(id)); charts.push(cache[id]); }
  return cache[id];
}
window.addEventListener('resize', () => charts.forEach(c => c.resize()));

const SUP_COLORS = {
  'extra':'#ffb703', 'mta_tax':'#06d6a0', 'improvement_surcharge':'#118ab2',
  'congestion_surcharge':'#ef476f', 'airport_fee':'#9b5de5', 'cbd_convenience_fee':'#f97316'
};
const SUP_LABELS = {
  'extra':'Extra', 'mta_tax':'MTA tax', 'improvement_surcharge':'Improvement',
  'congestion_surcharge':'Congestion', 'airport_fee':'Airport fee', 'cbd_convenience_fee':'CBD fee'
};
function lerp(a,b,t){ return Math.round(a+(b-a)*t); }
function ramp(t){
  const A=[17,138,178], B=[255,183,3];
  return `rgb(${lerp(A[0],B[0],t)},${lerp(A[1],B[1],t)},${lerp(A[2],B[2],t)})`;
}

const BASE = {
  backgroundColor:'transparent',
  textStyle:{ color:'#dbe4f0', fontFamily:'inherit' },
};

P.datasets.forEach((ds, i) => {

  /* ---------- KPI ---------- */
  document.querySelector(`[data-kpi="total-${i}"]`).textContent = fmt(ds.kpis.total_courses);
  document.querySelector(`[data-kpi="periode-${i}"]`).textContent =
    `${ds.kpis.periode.debut || '?'} → ${ds.kpis.periode.fin || '?'}`;
  document.querySelector(`[data-kpi="annees-${i}"]`).textContent =
    Object.keys(ds.kpis.par_annee).join(', ') || 'n/a';
  document.querySelector(`[data-kpi="vehicules-${i}"]`).textContent =
    Object.keys(ds.kpis.par_vehicule).join(', ') || 'n/a';
  const go = ds.meta.taille_octets;
  document.querySelector(`[data-kpi="taille-${i}"]`).textContent =
    go ? (go / 1e9).toFixed(2).replace('.', ',') + ' Go' : 'n/a';

  /* ---------- Analyse 1 : suppléments tarifaires ---------- */
  {
    const vehicules = [...new Set(ds.surcharges.rows.map(r => r.vehicle_type))].sort();
    const sel = document.getElementById(`veh-sel-${i}`);
    vehicules.forEach(v => sel.add(new Option(v, v)));
    const annees = [...new Set(ds.surcharges.rows.map(r => r.annee))].sort((a,b)=>a-b);

    function draw(){
      const v = sel.value;
      const rows = Object.fromEntries(ds.surcharges.rows.filter(r => r.vehicle_type === v)
                                      .map(r => [r.annee, r]));
      const series = ds.surcharges.supplements.filter(s =>
          ds.surcharges.rows.some(r => r.vehicle_type === v && r[s + '_moyen'] !== null))
        .map(s => ({
          name: SUP_LABELS[s] || s,
          type: 'line',
          smooth: true,
          symbol: 'circle',
          symbolSize: 6,
          connectNulls: false,
          data: annees.map(a => rows[a] ? rows[a][s + '_moyen'] : null),
          itemStyle: { color: SUP_COLORS[s] || '#8fa1ba' },
          lineStyle: { width: 2.5 }
        }));
      mk(`surcharge-${i}`).setOption({
        ...BASE,
        tooltip:{ trigger:'axis', valueFormatter:v=>v==null?'—':'$'+v },
        legend:{ top:0, textStyle:{color:'#8fa1ba'} },
        grid:{ left:60, right:30, top:44, bottom:45 },
        xAxis:{ type:'category', data:annees, axisLabel:{color:'#8fa1ba'},
                axisLine:{lineStyle:{color:'#1e2a41'}} },
        yAxis:{ type:'value', name:'$/course', nameTextStyle:{color:'#8fa1ba'},
                splitLine:{lineStyle:{color:'#1e2a41'}}, axisLabel:{color:'#8fa1ba'} },
        series
      }, true);
    }
    sel.addEventListener('change', draw);
    draw();
    const dispo = ds.surcharges.supplements.filter(s =>
      ds.surcharges.rows.some(r => r[s + '_moyen'] !== null));
    document.getElementById(`tk-surcharge-${i}`).innerHTML = dispo.length
      ? `Sur cet extrait, les composants renseignés sont : <b>${dispo.map(s=>SUP_LABELS[s]).join(', ')}</b>. ` +
        `Les autres restent à <b>null</b> : ils n'existaient pas encore à ces dates, ce qui n'équivaut pas à $0.`
      : `Aucun supplément renseigné dans cet échantillon.`;
  }

  /* ---------- Analyse 2 : chord des flux entre zones ---------- */
  {
    const fz = ds.flux_zones;
    if (!fz.nodes.length){
      document.getElementById(`chord-${i}`).innerHTML =
        '<p style="padding:30px;color:#8fa1ba">Aucune course avec identifiants de zone dans cet ' +
        'échantillon (les fichiers 2009 contiennent du GPS brut, pas de LocationID).</p>';
    } else {
      const nodeIds = new Set(fz.nodes.map(n => n.id));
      const links = fz.links.filter(l => nodeIds.has(l.source) && nodeIds.has(l.target));
      const maxPick = Math.max(...fz.nodes.map(n => n.pickups), 1);
      const maxLink = links.length ? links[0].count : 1;
      mk(`chord-${i}`).setOption({
        ...BASE,
        title:{ text:`${fmt(fz.courses_zonees)} courses zonées`, left:'center', top:6,
                textStyle:{color:'#8fa1ba', fontSize:13, fontWeight:'normal'} },
        tooltip:{ formatter:p => p.dataType === 'edge'
          ? `<b>Zone ${p.data.source} → Zone ${p.data.target}</b><br>${fmt(p.data.value)} courses`
          : `<b>Zone ${p.name}</b><br>${fmt(fz.nodes.find(n=>'Zone '+n.id===p.name)?.pickups ?? 0)} départs` },
        series:[{
          type:'graph', layout:'circular', circular:{ rotateLabel:true },
          data: fz.nodes.map(n => ({ name:'Zone '+n.id,
            symbolSize: 8 + 26*n.pickups/maxPick,
            itemStyle:{ color:'#ffb703', borderColor:'#0b1020', borderWidth:2 } })),
          links: links.map(l => ({ source:'Zone '+l.source, target:'Zone '+l.target,
            value:l.count, lineStyle:{ width: 1 + 6*l.count/maxLink,
              color:'#f97316', opacity:.55, curveness:.35 } })),
          emphasis:{ focus:'adjacency', lineStyle:{ opacity:1, width:5 } },
          label:{ color:'#dbe4f0', fontSize:11 },
          lineStyle:{ color:'#f97316', opacity:.5, curveness:.35 },
          roam:true
        }]
      });
      document.getElementById(`tk-chord-${i}`).innerHTML =
        `L'axe dominant est <b>Zone ${links[0].source} → Zone ${links[0].target}</b> avec ` +
        `${fmt(links[0].count)} courses (${fmt(fz.courses_non_zonees)} courses hors périmètre zoné).`;
    }
  }

  /* ---------- Analyse 3 : ridgeline prix / km par zone ---------- */
  {
    const zones = ds.prix_km.zones;
    if (!zones.length){
      document.getElementById(`ridge-${i}`).innerHTML =
        '<p style="padding:30px;color:#8fa1ba">Pas assez de données tarifaires dans cet échantillon ' +
        'pour construire le ridgeline.</p>';
    } else {
      const sel = document.getElementById(`zone-sel-${i}`);
      zones.forEach(z => sel.add(new Option('Zone ' + z, z)));
      const centers = ds.prix_km.bins.map((b, k) => k + 0.5);
      const H = 1;

      function draw(){
        const zone = +sel.value;
        const rows = ds.prix_km.rows.filter(r => r.zone === zone);
        const annees = [...new Set(rows.map(r => r.annee))].sort((a,b)=>a-b);
        const maxCount = Math.max(...rows.map(r => Math.max(...r.hist)), 1);
        const series = [];
        annees.forEach((a, j) => {
          const r = rows.find(x => x.annee === a);
          const off = j * H;
          const col = ramp(annees.length > 1 ? j/(annees.length-1) : 0);
          const pts = [[centers[0]-0.55, off]]
            .concat(centers.map((c, k) => [c, off + (r.hist[k]/maxCount)*0.92]))
            .concat([[centers[centers.length-1]+0.55, off]]);
          series.push({
            type:'line', smooth:true, symbol:'none', z:j+1, name:String(a), data:pts,
            lineStyle:{ width:1.6, color:col },
            areaStyle:{ color:col.replace('rgb','rgba').replace(')', ',.25)') }
          });
        });
        mk(`ridge-${i}`).setOption({
          ...BASE,
          tooltip:{ formatter:p => `Année ${p.seriesName} · ` +
            `${ds.prix_km.bins[Math.min(Math.max(Math.floor(p.value[0]),0), ds.prix_km.bins.length-1)]}` },
          grid:{ left:60, right:30, top:20, bottom:50 },
          xAxis:{ type:'value', min:-1, max:ds.prix_km.bins.length,
                  axisLabel:{ color:'#8fa1ba', formatter:v => Number.isInteger(v) ? v+'$' : '' },
                  splitLine:{ show:false } },
          yAxis:{ type:'value', max:(annees.length)*H + 0.6,
                  axisLabel:{ show:false }, splitLine:{ show:false } },
          series
        }, true);
        const last = rows.filter(r => r.annee === annees[annees.length-1]);
        const moy = last.length ? last.reduce((s,r)=>s+r.prix_km_moyen*r.courses,0) /
                    last.reduce((s,r)=>s+r.courses,0) : null;
        document.getElementById(`tk-ridge-${i}`).innerHTML =
          `Distribution des prix/km pour la <b>Zone ${zone}</b>, une crête par année ` +
          `(de ${annees[0]} en bas à ${annees[annees.length-1]} en haut)` +
          (moy != null ? `, moyenne ${String(moy).replace('.', ',')} $/km la dernière année.` : '.');
      }
      sel.addEventListener('change', draw);
      draw();
    }
  }

  /* ---------- Analyse 4 : heatmap jour x heure (année x véhicule) ---------- */
  {
    const anSel = document.getElementById(`an-sel-${i}`);
    const vtSel = document.getElementById(`vt-sel-${i}`);
    const annees = Object.keys(ds.heatmap).sort();
    annees.forEach(a => anSel.add(new Option(a, a)));

    function fillVeh(){
      vtSel.innerHTML = '';
      Object.keys(ds.heatmap[anSel.value] || {}).sort().forEach(v => vtSel.add(new Option(v, v)));
    }
    function draw(){
      const cell = (ds.heatmap[anSel.value] || {})[vtSel.value];
      if (!cell){ return; }
      let maxV = 0, bj=0, bh=0;
      cell.matrice.forEach((row,j)=>row.forEach((v,h)=>{ if(v>maxV){maxV=v;bj=j;bh=h;} }));
      const data = [];
      cell.matrice.forEach((row,j)=>row.forEach((v,h)=>data.push([h,j,v])));
      mk(`heat-${i}`).setOption({
        ...BASE,
        tooltip:{ position:'top',
          formatter:p=>`${cell.jours[p.value[1]]} ${p.value[0]}h : ${fmt(p.value[2])} courses` },
        grid:{ left:80, right:20, top:20, bottom:70 },
        xAxis:{ type:'category', data:cell.heures.map(h=>h+'h'), splitArea:{show:true},
                axisLine:{show:false}, axisTick:{show:false}, axisLabel:{color:'#8fa1ba'} },
        yAxis:{ type:'category', data:cell.jours, inverse:true,
                axisLine:{show:false}, axisTick:{show:false}, axisLabel:{color:'#dbe4f0'} },
        visualMap:{ min:0, max:maxV||1, calculable:false, orient:'horizontal', left:'center', bottom:6,
          textStyle:{color:'#8fa1ba'}, inRange:{ color:['#10243f','#155e75','#0ea5e9','#ffb703','#ffd166'] } },
        series:[{ type:'heatmap', data, label:{show:false},
          itemStyle:{ borderColor:'#121a2b', borderWidth:2 },
          emphasis:{ itemStyle:{ shadowBlur:8, shadowColor:'rgba(255,183,3,.5)' } } }]
      }, true);
      document.getElementById(`tk-heat-${i}`).innerHTML =
        `${anSel.value}, ${vtSel.value} : le créneau le plus chargé est ` +
        `<b>${cell.jours[bj]} autour de ${bh}h-${(bh+1)%24}h</b> (${fmt(maxV)} courses).`;
    }
    anSel.addEventListener('change', () => { fillVeh(); draw(); });
    vtSel.addEventListener('change', draw);
    fillVeh();
    draw();
  }

  /* ---------- Analyse 5 : météo ---------- */
  {
    const box = document.getElementById(`meteo-${i}`);
    if (ds.meteo.statut === 'en_attente'){
      box.innerHTML = `<div class="card warn"><div class="t">En attente de l'ingestion météo</div>
        <p style="color:var(--muted)">${ds.meteo.message}</p></div>`;
    } else {
      box.innerHTML = `<div class="card"><div class="t">Table météo disponible</div>
        <p style="color:var(--muted)">Colonnes silver/weather : ${ds.meteo.colonnes.join(', ')}.
        ${ds.meteo.message}</p></div>`;
    }
  }

});
</script>
</body>
</html>
