});

/* ---------- analyse 1 : suppléments ---------- */
const getMet = segCtl(`met-seg-${i}`, () => renderSurcharge());
function renderSurcharge(){
  const veSel = [...STATE.veh];
  const met = getMet();
  const field = met === 'total' ? '_total' : '_moyen';
  const rows0 = ds.surcharges.rows.filter(r => STATE.years.has(r.annee));
  const annees = [...new Set(rows0.map(r => r.annee))].sort((a,b)=>a-b);
  const series = [];
  const vehSelOrder = ALL_VEH.filter(v => veSel.includes(v));
  vehSelOrder.forEach(v => {
    const vi = vehSelOrder.indexOf(v);
    const rows = Object.fromEntries(rows0.filter(r => r.vehicle_type === v).map(r => [r.annee, r]));
    ds.surcharges.supplements.forEach(s => {
      if (!rows0.some(r => r.vehicle_type === v && r[s + field] !== null)) return;
      series.push({
        name: vehSelOrder.length > 1 ? `${SUP_LABELS[s]||s} · ${v}` : (SUP_LABELS[s]||s),
        type:'line', smooth:true, symbol:'circle', symbolSize:6, connectNulls:false,
        data: annees.map(a => rows[a] ? rows[a][s+field] : null),
        itemStyle:{ color:SUP_COLORS[s] || '#9fb8bc' },
        lineStyle:{ width:2.4, type:dashFor(vi), color:SUP_COLORS[s] || '#9fb8bc' }
      });
    });
  });
  const yName = met === 'total' ? '$ cumulés' : '$/course';
  mk(`surcharge-${i}`).setOption({
    ...BASE,
    tooltip:{ trigger:'axis', valueFormatter:v=>v==null?'—':(met==='total'?'$'+fmt(v):'$'+fmt2(v)) },
    legend:{ top:0, type:'scroll', textStyle:{color:'#9fb8bc'}, icon:'roundRect' },
    grid:{ left:64, right:30, top:56, bottom:45 },
    xAxis:{ type:'category', data:annees, ...AX },
    yAxis:{ type:'value', name:yName, nameTextStyle:{color:'#9fb8bc'}, ...AX },
    series
  }, true);
  const dispo = ds.surcharges.supplements.filter(s =>
    ds.surcharges.rows.some(r => r[s + '_moyen'] !== null));
  document.getElementById(`tk-surcharge-${i}`).innerHTML = dispo.length
    ? `Composants renseignés sur l'extrait : <b>${dispo.map(s=>SUP_LABELS[s]).join(', ')}</b>. ` +
      `Les autres restent à <b>null</b> : ils n'existaient pas encore à ces dates, ce qui n'équivaut pas à $0.`
    : `Aucun supplément renseigné dans cet échantillon.`;
}

/* ---------- analyse 2 : flux (corde / sankey / barres) ---------- */
const getFlow = segCtl(`flow-seg-${i}`, () => renderFlow());
function renderFlow(){
  const fz = ds.flux_zones;
  const box = document.getElementById(`chord-${i}`);
  const empty = () => {
    box.innerHTML = '<p class="empty">Aucune course avec identifiants de zone dans cet échantillon ' +
                    '(les fichiers 2009 contiennent du GPS brut, pas de LocationID).</p>';
    document.getElementById(`tk-chord-${i}`).innerHTML = '';
    return false;
  };
  if (!fz.nodes.length) { empty(); return; }
  const nodeIds = new Set(fz.nodes.map(n => n.id));
  const links = fz.links.filter(l => nodeIds.has(l.source) && nodeIds.has(l.target));
  const v = getFlow();
  if (v === 'chord'){
    const maxPick = Math.max(...fz.nodes.map(n => n.pickups), 1);
    const maxLink = links.length ? links[0].count : 1;
    const cols = spread(fz.nodes.length);
    mk(`chord-${i}`).setOption({
      ...BASE,
      title:{ text:`${fmt(fz.courses_zonees)} courses zonées`, left:'center', top:6,
              textStyle:{color:'#9fb8bc', fontSize:13, fontWeight:'normal'} },
      tooltip:{ formatter:p => p.dataType === 'edge'
        ? `<b>${zname(p.data.source)} → ${zname(p.data.target)}</b><br>${fmt(p.data.value)} courses`
        : `<b>${p.name}</b><br>${fmt(fz.nodes.find(n=>zname(n.id)===p.name)?.pickups ?? 0)} départs` },
      series:[{
        type:'graph', layout:'circular', circular:{ rotateLabel:true },
        data: fz.nodes.map((n,j) => ({ name: zname(n.id),
          symbolSize: 8 + 26*n.pickups/maxPick,
          itemStyle:{ color:cols[j], borderColor:'#13222a', borderWidth:2 } })),
        links: links.map(l => ({ source: zname(l.source), target: zname(l.target),
          value:l.count, lineStyle:{ width: 1 + 6*l.count/maxLink,
            color:'#f4a261', opacity:.5, curveness:.35 } })),
        emphasis:{ focus:'adjacency', lineStyle:{ opacity:1, width:5 } },
        label:{ color:'#eef4f4', fontSize:10 },
        roam:true
      }]
    }, true);
  } else if (v === 'matrix'){
    const topP = [...fz.nodes].sort((a,b) => b.pickups-a.pickups).slice(0, 15).map(n => n.id);
    const setP = new Set(topP);
    const cell = {};
    links.forEach(l => {
      if (!setP.has(l.source) || !setP.has(l.target)) return;
      const k = l.source + '_' + l.target;
      cell[k] = (cell[k] || 0) + l.count;
    });
    const data = [];
    let maxC = 0;
    topP.forEach((s, yi) => topP.forEach((d, xi) => {
      const c = cell[s + '_' + d];
      if (c){ data.push([xi, yi, c]); if (c > maxC) maxC = c; }
    }));
    mk(`chord-${i}`).setOption({
      ...BASE,
      title:{ text:`Top 15 × 15 — origine (lignes) → destination (colonnes)`,
              left:'center', top:6, textStyle:{color:'#9fb8bc', fontSize:13, fontWeight:'normal'} },
      tooltip:{ position:'top',
        formatter:p => p.value == null ? '' :
          `<b>${zname(topP[p.value[1]])}</b> → <b>${zname(topP[p.value[0]])}</b><br>` +
          `${fmt(p.value[2])} courses` },
      grid:{ left:20, right:110, top:40, bottom:90, containLabel:true },
      xAxis:{ type:'category', data:topP.map(z => zname(z)),
              axisLabel:{color:'#9fb8bc', fontSize:9, rotate:45},
              axisLine:{show:false}, axisTick:{show:false} },
      yAxis:{ type:'category', data:topP.map(z => zname(z)), inverse:true,
              axisLabel:{color:'#eef4f4', fontSize:10, width:110, overflow:'truncate'},
              axisLine:{show:false}, axisTick:{show:false} },
      visualMap:{ min:0, max:maxC || 1, calculable:true, orient:'vertical', right:4, top:'middle',
        textStyle:{color:'#9fb8bc'}, inRange:{ color: VIRIDIS } },
      series:[{ type:'heatmap', data,
        itemStyle:{ borderColor:'#1b313b', borderWidth:2, borderRadius:3 },
        emphasis:{ itemStyle:{ shadowBlur:8, shadowColor:'rgba(233,196,106,.6)' } } }]
    }, true);
  } else {
    const tops = [...fz.nodes].sort((a,b) => b.pickups-a.pickups).slice(0, 12);
    const cols = spread(tops.length);
    mk(`chord-${i}`).setOption({
      ...BASE,
      title:{ text:`${fmt(fz.courses_zonees)} courses zonées — départs par zone (top ${tops.length})`,
              left:'center', top:6, textStyle:{color:'#9fb8bc', fontSize:13, fontWeight:'normal'} },
      tooltip:{ trigger:'axis', axisPointer:{type:'shadow'},
                formatter:p => `<b>${p[0].name}</b><br>${fmt(p[0].value)} départs` },
      grid:{ left:20, right:50, top:40, bottom:30, containLabel:true },
      xAxis:{ type:'value', axisLabel:{color:'#9fb8bc', formatter:v=>fmt(v)},
              splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} },
      yAxis:{ type:'category', data:tops.map(n=>zname(n.id)).reverse(),
              axisLabel:{color:'#eef4f4', width:130, overflow:'truncate'},
              axisLine:{show:false}, axisTick:{show:false} },
      series:[{ type:'bar', barMaxWidth:22,
        data:[...tops].reverse().map((n,j) => ({ value:n.pickups,
          itemStyle:{ color:cols[tops.length-1-j], borderRadius:[0,6,6,0] } })) }]
    }, true);
  }
  document.getElementById(`tk-chord-${i}`).innerHTML =
    `L'axe dominant est <b>${zname(links[0].source)} → ${zname(links[0].target)}</b> avec ` +
    `${fmt(links[0].count)} courses (${fmt(fz.courses_non_zonees)} courses hors périmètre zoné).`;
}

/* ---------- analyse 3 : ridgeline + comparateur ---------- */
const CMP_ZONES = ds.prix_km.zones.slice(0, Math.min(ds.prix_km.zones.length, 6));
let cmpGet = null;
function buildCmpChips(){
  if (CMP_ZONES.length) cmpGet = chipBox(`zone-chips-${i}`, CMP_ZONES, drawCmp, {fmt: v => zname(+v)});
}

function renderRidge(){
  const zones = ds.prix_km.zones;
  const sel = document.getElementById(`zone-sel-${i}`);
  if (!zones.length){
    sel.closest('.controls').style.display = 'none';
    document.getElementById(`ridge-${i}`).innerHTML =
      '<p class="empty">Pas assez de données tarifaires zonées dans cet échantillon.</p>';
    document.getElementById(`tk-ridge-${i}`).innerHTML = '';
    document.getElementById(`cmpzone-${i}`).innerHTML =
      '<p class="empty">Comparateur indisponible sans zones.</p>';
    document.getElementById(`tk-cmpzone-${i}`).innerHTML = '';
    return;
  }
  if (sel.options.length !== zones.length){
    sel.innerHTML = '';
    zones.forEach(z => sel.add(new Option(zname(z), z)));
  }
  const H = 1;
  const centers = ds.prix_km.bins.map((b, k) => k + 0.5);
  const zone = +sel.value;
  const rows = ds.prix_km.rows.filter(r => r.zone === zone && STATE.years.has(r.annee));
  const annees = [...new Set(rows.map(r => r.annee))].sort((a,b)=>a-b);
  const maxCount = rows.length ? Math.max(...rows.map(r => Math.max(...r.hist)), 1) : 1;
  const series = [];
  annees.forEach((a, j) => {
    const r = rows.find(x => x.annee === a);
    const off = j * H;
    const col = vcolor(annees.length > 1 ? j/(annees.length-1) : .5);
    const pts = [[centers[0]-0.55, off]]
      .concat(centers.map((c, k) => [c, off + (r.hist[k]/maxCount)*0.92]))
      .concat([[centers[centers.length-1]+0.55, off]]);
    series.push({
      type:'line', smooth:true, symbol:'none', z:j+1, name:String(a), data:pts,
      lineStyle:{ width:1.6, color:col },
      areaStyle:{ color:col.replace('rgb','rgba').replace(')', ',.25)') }
    });
  });
  mk(`ridge-${i}`).setOption({
    ...BASE,
    tooltip:{ formatter:p => `Année ${p.seriesName} · ` +
      `${ds.prix_km.bins[Math.min(Math.max(Math.floor(p.value[0]),0), ds.prix_km.bins.length-1)]}` },
    grid:{ left:60, right:30, top:20, bottom:50 },
    xAxis:{ type:'value', min:-1, max:ds.prix_km.bins.length,
            axisLabel:{ color:'#9fb8bc', formatter:v => Number.isInteger(v) ? v+'$' : '' },
            splitLine:{ show:false } },
    yAxis:{ type:'value', max:Math.max(annees.length,1)*H + 0.6,
            axisLabel:{ show:false }, splitLine:{ show:false } },
    series
  }, true);
  const last = rows.filter(r => r.annee === annees[annees.length-1]);
  const moy = last.length ? last.reduce((s,r)=>s+r.prix_km_moyen*r.courses,0) /
              last.reduce((s,r)=>s+r.courses,0) : null;
  document.getElementById(`tk-ridge-${i}`).innerHTML =
    `Distribution des prix/km pour <b>${zname(zone)}</b>, une crête par année ` +
    `(de ${annees[0] ?? '—'} en bas — clair — à ${annees[annees.length-1] ?? '—'} en haut — foncé)` +
    (moy != null ? `, moyenne ${fmt2(moy)} $/km la dernière année.` : '.');
}
document.getElementById(`zone-sel-${i}`).addEventListener('change', renderRidge);

function drawCmp(){
  const picked = cmpGet ? cmpGet().map(Number) : CMP_ZONES;
  const rowsF = ds.prix_km.rows.filter(r => picked.includes(r.zone) && STATE.years.has(r.annee));
  const annees = [...new Set(rowsF.map(r => r.annee))].sort((a,b)=>a-b);
  const cols = spread(picked.length || 1);
  const series = picked.map((z, j) => ({
    name: zname(z), type:'line', smooth:true, symbol:'circle', symbolSize:7,
    data: annees.map(a => {
      const r = rowsF.find(x => x.zone===z && x.annee===a);
      return r && r.courses ? +(r.prix_km_moyen.toFixed(3)) : null;
    }),
    itemStyle:{color:cols[j]}, lineStyle:{width:2.6, color:cols[j]},
    emphasis:{ focus:'series' }
  }));
  mk(`cmpzone-${i}`).setOption({
    ...BASE,
    tooltip:{ trigger:'axis', valueFormatter:v=>v==null?'—':fmt2(v)+' $/km' },
    legend:{ top:0, textStyle:{color:'#9fb8bc'} },
    grid:{ left:64, right:30, top:44, bottom:45 },
    xAxis:{ type:'category', data:annees, ...AX },
    yAxis:{ type:'value', name:'$/km', nameTextStyle:{color:'#9fb8bc'}, ...AX },
    series
  }, true);
  const best = rowsF.length
    ? rowsF.reduce((m,r) => r.prix_km_moyen < m.prix_km_moyen ? r : m) : null;
  document.getElementById(`tk-cmpzone-${i}`).innerHTML = best
    ? `Zone la moins chère au km parmi la sélection : <b>${zname(best.zone)}</b> ` +
      `(${fmt2(best.prix_km_moyen)} $/km en ${best.annee}).`
    : '';
}

/* ---------- analyse 4 : heatmap + profil ---------- */
function fillHeatSelectors(){
  const anSel = document.getElementById(`an-sel-${i}`);
  const vtSel = document.getElementById(`vt-sel-${i}`);
  const cur = anSel.value;
  anSel.innerHTML = '';
  ALL_YEARS.filter(y => STATE.years.has(y) && ds.heatmap[String(y)]).forEach(a =>
    anSel.add(new Option(a, a)));
  if ([...anSel.options].some(o => o.value === cur)) anSel.value = cur;
  fillVt();
}
function fillVt(){
  const anSel = document.getElementById(`an-sel-${i}`);
  const vtSel = document.getElementById(`vt-sel-${i}`);
  const cur = vtSel.value;
  vtSel.innerHTML = '';
  Object.keys(ds.heatmap[anSel.value] || {}).sort()
    .filter(v => STATE.veh.has(v))
    .forEach(v => vtSel.add(new Option(v, v)));
  if ([...vtSel.options].some(o => o.value === cur)) vtSel.value = cur;
}
function renderHeat(){
  const anSel = document.getElementById(`an-sel-${i}`);
  const vtSel = document.getElementById(`vt-sel-${i}`);
  const cell = (ds.heatmap[anSel.value] || {})[vtSel.value];
  if (!cell){ mk(`heat-${i}`).clear(); return; }
  let maxV = 0, bj=0, bh=0;
  cell.matrice.forEach((row,j)=>row.forEach((v,h)=>{ if(v>maxV){maxV=v;bj=j;bh=h;} }));
  const data = [];
  cell.matrice.forEach((row,j)=>row.forEach((v,h)=>data.push([h,j,v])));
  mk(`heat-${i}`).setOption({
    ...BASE,
    tooltip:{ position:'top',
      formatter:p=>`${cell.jours[p.value[1]]} ${p.value[0]}h : ${fmt(p.value[2])} courses` },
    grid:{ left:80, right:20, top:20, bottom:70 },
    xAxis:{ type:'category', data:cell.heures.map(h=>h+'h'), splitArea:{show:true},
            axisLine:{show:false}, axisTick:{show:false},
            axisLabel:{color:'#9fb8bc', interval:1} },
    yAxis:{ type:'category', data:cell.jours, inverse:true,
            axisLine:{show:false}, axisTick:{show:false}, axisLabel:{color:'#eef4f4'} },
    visualMap:{ min:0, max:maxV||1, calculable:false, orient:'horizontal', left:'center', bottom:6,
      textStyle:{color:'#9fb8bc'}, inRange:{ color: VIRIDIS } },
    series:[{ type:'heatmap', data, label:{show:false},
      itemStyle:{ borderColor:'#1b313b', borderWidth:2 },
      emphasis:{ itemStyle:{ shadowBlur:10, shadowColor:'rgba(233,196,106,.6)' } } }]
  }, true);
  document.getElementById(`tk-heat-${i}`).innerHTML =
    `${anSel.value}, ${vtSel.value} : le créneau le plus chargé est ` +
    `<b>${cell.jours[bj]} autour de ${bh}h-${(bh+1)%24}h</b> (${fmt(maxV)} courses).`;
}
function renderProfil(){
  const anSel = document.getElementById(`an-sel-${i}`);
  const yearData = ds.heatmap[anSel.value] || {};
  const vehs = Object.keys(yearData).sort().filter(v => STATE.veh.has(v));
  const heures = (yearData[vehs[0]] || {}).heures || [];
  const cols = spread(vehs.length || 1);
  const series = vehs.map((v, j) => {
    const prof = heures.map((_, h) => yearData[v].matrice.reduce((s,row) => s + (row[h]||0), 0));
    return { name:v, type:'line', smooth:true, symbol:'circle', symbolSize:5,
             data:prof, itemStyle:{color:cols[j]}, lineStyle:{width:2.6, color:cols[j]},
             areaStyle:{ color:cols[j].replace('rgb','rgba').replace(')', ',.08)') } };
  });
  mk(`profil-${i}`).setOption({
    ...BASE,
    tooltip:{ trigger:'axis' },
    legend:{ top:0, textStyle:{color:'#9fb8bc'} },
    grid:{ left:70, right:24, top:40, bottom:40 },
    xAxis:{ type:'category', data:heures.map(h=>h+'h'), boundaryGap:false, ...AX },
    yAxis:{ type:'value', axisLabel:{color:'#9fb8bc', formatter:v=>fmt(v)},
            splitLine:{lineStyle:{color:'rgba(255,255,255,.06)'}} },
    series
  }, true);
  let peak = null;
  vehs.forEach(v => {
    heures.forEach((_, h) => {
      const val = yearData[v].matrice.reduce((s,row)=>s+(row[h]||0),0);
      if (!peak || val > peak.val) peak = {v, h, val};
    });
  });
  document.getElementById(`tk-profil-${i}`).innerHTML = peak
    ? `En ${anSel.value}, le pic horaire absolu revient à <b>${peak.v}</b> à ` +
      `<b>${peak.h}h</b> (${fmt(peak.val)} courses sur la semaine).`
    : '';
}
document.getElementById(`an-sel-${i}`).addEventListener('change', () => { fillVt(); renderHeat(); renderProfil(); });
document.getElementById(`vt-sel-${i}`).addEventListener('change', () => { renderHeat(); });

/* ---------- analyse 6 : distance + pourboire ---------- */
function renderDistanceTips(){
  const anneesF = [...STATE.years].sort((a,b) => a-b);

  /* prix/km par bande de distance : une courbe par annee */
  {
    const rows = ds.distance.rows.filter(r => STATE.years.has(r.annee));
    const series = anneesF.map((a, j) => {
      const col = vcolor(anneesF.length > 1 ? j/(anneesF.length-1) : .5);
      return { name:String(a), type:'line', smooth:true, symbol:'circle', symbolSize:6,
        data: ds.distance.bandes.map(b => {
          const r = rows.find(x => x.annee === a && x.bande === b);
          return r ? r.prix_km_moyen : null;
        }),
        itemStyle:{color:col}, lineStyle:{width:2.4, color:col} };
    });
    mk(`dist-${i}`).setOption({
      ...BASE,
      tooltip:{ trigger:'axis', valueFormatter:v=>v==null?'—':fmt2(v)+' $/km' },
      legend:{ top:0, textStyle:{color:'#9fb8bc'} },
      grid:{ left:56, right:20, top:36, bottom:50 },
      xAxis:{ type:'category', data:ds.distance.bandes, ...AX },
      yAxis:{ type:'value', name:'$/km', nameTextStyle:{color:'#9fb8bc'}, ...AX },
      series
    }, true);
    const short = rows.filter(r => r.bande === '0-1 km');
    const long = rows.filter(r => r.bande === '20+ km');
    if (short.length && long.length){
      const sAvg = short.reduce((s,r)=>s+r.prix_km_moyen*r.courses,0)/short.reduce((s,r)=>s+r.courses,0);
      const lAvg = long.reduce((s,r)=>s+r.prix_km_moyen*r.courses,0)/long.reduce((s,r)=>s+r.courses,0);
      document.getElementById(`tk-dist-${i}`).innerHTML =
        `Une course de moins d'1 km coûte <b>${fmt2(sAvg)} $/km</b> contre ` +
        `<b>${fmt2(lAvg)} $/km</b> au-delà de 20 km, soit ` +
        `<b>${fmt2(sAvg/lAvg)}× plus cher au kilomètre</b> : la prise en charge est amortie ` +
        `sur la durée, pas sur la distance.`;
    }
  }

  /* taux de pourboire par annee : une courbe par vehicule */
  {
    const rows = ds.tips.rows.filter(r => STATE.years.has(r.annee) && STATE.veh.has(r.vehicle));
    const vehs = ALL_VEH.filter(v => STATE.veh.has(v) && rows.some(r => r.vehicle === v));
    const cols = spread(vehs.length || 1);
    const series = vehs.map((v, j) => ({
      name:v, type:'line', smooth:true, symbol:'circle', symbolSize:6,
      data: anneesF.map(a => {
        const r = rows.find(x => x.annee === a && x.vehicle === v);
        return r ? r.taux_pct : null;
      }),
      itemStyle:{color:cols[j]}, lineStyle:{width:2.4, color:cols[j]}
    }));
    mk(`tips-${i}`).setOption({
      ...BASE,
      tooltip:{ trigger:'axis', valueFormatter:v=>v==null?'—':fmt2(v)+' % du tarif' },
      legend:{ top:0, textStyle:{color:'#9fb8bc'} },
      grid:{ left:56, right:20, top:36, bottom:50 },
      xAxis:{ type:'category', data:anneesF.map(String), ...AX },
      yAxis:{ type:'value', name:'% du tarif', nameTextStyle:{color:'#9fb8bc'}, ...AX },
      series
    }, true);
  }
}

/* ---------- analyse 5 : météo ---------- */
let weatherReady = false;
function renderWeather(){
  const box = document.getElementById(`meteo-${i}`);
  if (ds.meteo.statut !== 'ok'){
    if (!box.innerHTML.trim()){
      box.innerHTML = `<div class="card warn"><div class="t">En attente de l'ingestion météo</div>
        <p style="color:var(--muted)">${ds.meteo.message}</p></div>`;
    }
    return;
  }
  if (!weatherReady){
    box.innerHTML = `
      <div class="chart-title"><b>Prix/km selon les conditions météo</b>
        <span>au moment de la prise en charge · barre = prix/km moyen · ligne = moyenne générale</span></div>
      <div id="wcond-${i}" class="chart" style="height:380px"></div>
      <div class="chart-title" style="margin-top:20px"><b>Prix/km selon la température</b>
        <span>bandes de 10°C à l'heure de la course</span></div>
      <div id="wtemp-${i}" class="chart" style="height:360px"></div>
      <div class="chart-title" style="margin-top:20px"><b>Heatmap condition × heure</b>
        <span>prix/km moyen, 24h × météo · viridis du clair au foncé</span></div>
      <div id="wheat-${i}" class="chart" style="height:360px"></div>
      <div class="takeaway" id="tk-meteo-${i}"></div>`;
    weatherReady = true;
  }
  const pick = rows => rows.filter(r => STATE.years.has(r.annee));
  function aggBy(rows, dim){
    const agg = {};
    pick(rows).forEach(r => {
      const b = agg[r[dim]] = agg[r[dim]] || {c:0, s:0};
      b.c += r.courses; b.s += r.prix_km_moyen * r.courses;
    });
    return Object.entries(agg).map(([k, b]) => ({k, v: b.s / b.c, c: b.c}))
                             .sort((a,b) => b.v - a.v);
  }
  const gRows = pick(ds.meteo.global_rows);
  const gAvg = gRows.length
    ? gRows.reduce((s,r) => s + r.prix_km_moyen * r.courses, 0) /
      gRows.reduce((s,r) => s + r.courses, 0) : null;
  function drawChart(divId, rows, dim, order){
    const agg = aggBy(rows, dim).filter(x => order.includes(x.k));
    const ordered = order.map(k => agg.find(x => x.k === k)).filter(Boolean);
    mk(divId).setOption({
      ...BASE,
      tooltip:{ trigger:'axis', axisPointer:{type:'shadow'},
        formatter:p => { const d = p[0];
          const dev = gAvg ? ((d.value - gAvg) / gAvg * 100) : null;
          return `<b>${d.name}</b><br>${fmt2(d.value)} $/km` +
                 (dev != null ? `<br>${dev >= 0 ? '+' : ''}${dev.toFixed(1).replace('.', ',')}% vs moyenne` : '') +
                 `<br>${fmt(d.data.c)} courses`; } },
      grid:{ left:64, right:30, top:30, bottom:60 },
      xAxis:{ type:'category', data:ordered.map(x => x.k),
              axisLabel:{color:'#9fb8bc', fontSize:11, rotate:20},
              axisLine:{lineStyle:{color:'rgba(255,255,255,.12)'}} },
      yAxis:{ type:'value', name:'$/km', nameTextStyle:{color:'#9fb8bc'}, ...AX },
      series:[{ type:'bar', barMaxWidth:52,
        data: ordered.map(x => ({ value:+x.v.toFixed(3), c:x.c,
          itemStyle:{ color: gAvg && x.v > gAvg ? '#e76f51' : '#2a9d8f',
                      borderRadius:[6,6,0,0] } })),
        label:{ show:true, position:'top', color:'#9fb8bc', fontSize:10,
                formatter:p => fmt2(p.value) },
        ...(gAvg != null ? { markLine:{ symbol:'none', silent:true,
          lineStyle:{ color:'#e9c46a', type:'dashed', width:1.5 },
          label:{ color:'#e9c46a', formatter:'moyenne ' + fmt2(gAvg) },
          data:[{ yAxis:+gAvg.toFixed(3) }] } } : {}) }]
    }, true);
  }
  drawChart(`wcond-${i}`, ds.meteo.rows, 'condition', ds.meteo.conditions);
  drawChart(`wtemp-${i}`, ds.meteo.temp_rows, 'bande', ds.meteo.temp_bandes);

  /* heatmap condition x heure */
  {
    const hRows = pick(ds.meteo.hour_rows || []);
    const aggH = {};
    hRows.forEach(r => {
      const b = aggH[r.condition + '_' + r.heure] =
        aggH[r.condition + '_' + r.heure] || {c:0, s:0};
      b.c += r.courses; b.s += r.prix_km_moyen * r.courses;
    });
    const conds = ds.meteo.conditions.filter(c =>
      ds.meteo.hour_rows.some(r => r.condition === c && STATE.years.has(r.annee)));
    const data = [];
    let maxV = 0;
    conds.forEach((c, yi) => {
      for (let h = 0; h < 24; h++){
        const b = aggH[c + '_' + h];
        if (b && b.c){ data.push([h, yi, +(b.s/b.c).toFixed(2)]); if (b.s/b.c > maxV) maxV = b.s/b.c; }
      }
    });
    mk(`wheat-${i}`).setOption({
      ...BASE,
      tooltip:{ position:'top',
        formatter:p => `<b>${conds[p.value[1]]}</b> à ${p.value[0]}h<br>` +
          `${fmt2(p.value[2])} $/km en moyenne` },
      grid:{ left:80, right:20, top:16, bottom:60 },
      xAxis:{ type:'category', data:[...Array(24).keys()].map(h => h + 'h'),
              splitArea:{show:true}, axisLine:{show:false}, axisTick:{show:false},
              axisLabel:{color:'#9fb8bc', interval:2} },
      yAxis:{ type:'category', data:conds, inverse:true,
              axisLine:{show:false}, axisTick:{show:false}, axisLabel:{color:'#eef4f4'} },
      visualMap:{ min:0, max:maxV || 1, calculable:true, orient:'horizontal',
        left:'center', bottom:4, textStyle:{color:'#9fb8bc'}, inRange:{ color: VIRIDIS } },
      series:[{ type:'heatmap', data,
        itemStyle:{ borderColor:'#1b313b', borderWidth:2 },
        emphasis:{ itemStyle:{ shadowBlur:8, shadowColor:'rgba(233,196,106,.6)' } } }]
    }, true);
  }

  const condAgg = aggBy(ds.meteo.rows, 'condition');
  const chere = condAgg[0], cmoins = condAgg[condAgg.length-1];
  document.getElementById(`tk-meteo-${i}`).innerHTML =
    (chere && cmoins && gAvg)
    ? `Météo la plus chère au km : <b>${chere.k}</b> (${fmt2(chere.v)} $/km, ` +
      `${((chere.v - gAvg) / gAvg * 100).toFixed(1).replace('.', ',')}% au-dessus de la moyenne) ; ` +
      `la moins chère : <b>${cmoins.k}</b> (${fmt2(cmoins.v)} $/km). ` +
      `Rouge = au-dessus de la moyenne générale, vert = en dessous.`
    : '';
}
renderWeather();

/* ---------- orchestration des filtres ---------- */
function applyFilters(){
  STATE.years = new Set(getGY().map(Number));
  STATE.veh = new Set(getGV());
  history.replaceState(null, '', '#f=' + [...STATE.years].join(',') + '|' + [...STATE.veh].join(','));
  renderKpis(); renderOverview(); renderTimeline(); renderSurcharge(); renderFlow();
  renderRidge(); drawCmp(); fillHeatSelectors(); renderHeat(); renderProfil();
  renderDistanceTips();
  renderMap(); renderTopZones(); renderZoneCard(); renderWeather();
}

buildCmpChips();
renderKpis(); renderOverview(); renderTimeline(); renderSurcharge(); renderFlow();
renderRidge(); fillHeatSelectors(); renderHeat(); renderProfil();
renderDistanceTips();
});
</script>
